<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="dynamicPageTitle">financiesuaobra.com.br | Construção Financiada Caixa - Grupo Geminadas.com & Level</title>
    <link id="dynamicFavicon" rel="icon" type="image/svg+xml" href="">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            blue: '#0F3156',
                            blueLight: '#1A4B82',
                            blueDark: '#091E36',
                            green: '#138A59',
                            greenLight: '#19B374',
                            greenDark: '#0D633F',
                            ice: '#F4F7F9'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1E293B;
            background-color: #FFFFFF;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, .font-display {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Custom Range Slider Styling */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 8px;
            background: #E2E8F0;
            border-radius: 999px;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #138A59;
            cursor: pointer;
            border: 3px solid #FFFFFF;
            box-shadow: 0 2px 6px rgba(15, 49, 86, 0.35);
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.15);
            background: #0F3156;
        }
        /* Inline Direct Editing Mode Styles */
        body.direct-edit-active [data-editable="true"] {
            outline: 2px dashed #138A59;
            outline-offset: 4px;
            border-radius: 6px;
            cursor: text;
            transition: all 0.2s ease;
            position: relative;
        }
        body.direct-edit-active [data-editable="true"]:hover,
        body.direct-edit-active [data-editable="true"]:focus {
            outline: 2px solid #19B374;
            background-color: rgba(19, 138, 89, 0.08);
        }
        .draggable-handle {
            cursor: grab;
        }
        .draggable-handle:active {
            cursor: grabbing;
        }
        /* Smooth Pulse for WhatsApp Floating Button */
        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(19, 138, 89, 0.7); }
            70% { box-shadow: 0 0 0 15px rgba(19, 138, 89, 0); }
            100% { box-shadow: 0 0 0 0 rgba(19, 138, 89, 0); }
        }
        .whatsapp-pulse {
            animation: pulse-green 2s infinite;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F4F7F9;
        }
        ::-webkit-scrollbar-thumb {
            background: #0F3156;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #138A59;
        }
    </style>
</head>
<body class="antialiased selection:bg-brand-green selection:text-white">

    <!-- NOTIFICATION TOAST -->
    <div id="toastContainer" class="fixed top-20 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>

    <!-- TOP BAR: GROUP AUTHORITY & SOCIAL LINKS -->
    <div class="bg-brand-blueDark text-white/90 text-xs py-2 px-4 border-b border-white/10">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2 sm:gap-4 flex-wrap">
                <span class="inline-flex items-center gap-1.5 font-medium text-brand-greenLight">
                    <i class="fa-solid fa-layer-group"></i> Ecossistema Completo:
                </span>
                <span class="hover:text-white transition"><strong>Geminadas.com</strong> (Arquitetura)</span>
                <span class="text-white/30">•</span>
                <span class="hover:text-white transition"><strong>Level</strong> (Construtora)</span>
                <span class="text-white/30 hidden sm:inline">•</span>
                <span class="hidden sm:inline text-white font-semibold">financiesuaobra.com.br</span>
            </div>
            <div class="flex items-center gap-4 ml-auto">
                <div class="flex items-center gap-3" id="topSocialLinks">
                    <!-- Populated via JS -->
                </div>
                <button onclick="toggleDirectEditMode()" id="directEditToggleBtn" class="bg-brand-green/20 hover:bg-brand-green border border-brand-greenLight/40 text-emerald-300 hover:text-white px-2.5 py-1 rounded-md text-xs font-semibold transition flex items-center gap-1.5" title="Editar textos e barras direto na página">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span id="directEditBtnLabel">Editar Direto no Site</span>
                </button>
                <button onclick="toggleView('admin')" id="adminToggleBtnTop" class="bg-white/10 hover:bg-brand-green text-white px-2.5 py-1 rounded-md text-xs font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-sliders"></i> <span id="adminBtnLabel">Painel Admin</span>
                </button>
            </div>
        </div>
    </div>

    <!-- FLOATING DRAGGABLE QUICK-EDIT BAR (MOVABLE DIRECTLY ON THE SITE) -->
    <div id="floatingQuickAdminBar" class="hidden fixed top-24 left-4 z-50 w-80 sm:w-96 bg-brand-blueDark/95 backdrop-blur-md text-white rounded-3xl shadow-2xl border-2 border-brand-green overflow-hidden">
        <!-- Drag Handle Header -->
        <div id="quickAdminDragHeader" class="draggable-handle bg-gradient-to-r from-brand-blue to-brand-green px-4 py-3 flex items-center justify-between select-none">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider">
                <i class="fa-solid fa-arrows-up-down-left-right text-emerald-300"></i>
                <span>Barra Arrastável • Edição ao Vivo</span>
            </div>
            <button onclick="toggleDirectEditMode()" class="w-7 h-7 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="p-4 space-y-3 text-xs max-h-[75vh] overflow-y-auto">
            <div class="bg-white/10 rounded-xl p-3 border border-white/10">
                <p class="text-emerald-300 font-semibold flex items-center gap-1.5">
                    <i class="fa-solid fa-pen-nib"></i> Edição de Textos Ativa!
                </p>
                <p class="text-slate-300 text-[11px] mt-1">
                    Clique em qualquer título ou texto tracejado na página para digitar diretamente. Arraste esta caixa por onde quiser!
                </p>
            </div>

            <div class="space-y-2">
                <label class="block font-bold uppercase text-emerald-300">WhatsApp Rápido (Com DDD)</label>
                <input type="text" id="quickCfgWhatsapp" oninput="syncQuickAdminChanges()" placeholder="5544999999999" class="w-full rounded-xl bg-white/10 border border-white/20 px-3 py-2 text-white font-semibold focus:outline-none focus:border-brand-greenLight">
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block font-bold uppercase text-slate-300 mb-1">Telefone Exibido</label>
                    <input type="text" id="quickCfgPhone" oninput="syncQuickAdminChanges()" placeholder="(44) 99999-9999" class="w-full rounded-xl bg-white/10 border border-white/20 px-2.5 py-1.5 text-white focus:outline-none focus:border-brand-greenLight">
                </div>
                <div>
                    <label class="block font-bold uppercase text-slate-300 mb-1">Margem Mercado (%)</label>
                    <input type="number" id="quickCfgMargin" value="30" min="15" max="50" oninput="updateHeroInteractiveCard(); updateVantagensInteractive();" class="w-full rounded-xl bg-white/10 border border-white/20 px-2.5 py-1.5 text-emerald-300 font-bold focus:outline-none focus:border-brand-greenLight">
                </div>
            </div>

            <div class="space-y-1.5 pt-1 border-t border-white/10">
                <label class="block font-bold uppercase text-emerald-300">Redes Sociais na Capa</label>
                <input type="text" id="quickCfgInstagram" oninput="syncQuickAdminChanges()" placeholder="Link do Instagram" class="w-full rounded-lg bg-white/10 border border-white/15 px-2.5 py-1.5 text-white focus:outline-none">
                <input type="text" id="quickCfgFacebook" oninput="syncQuickAdminChanges()" placeholder="Link do Facebook" class="w-full rounded-lg bg-white/10 border border-white/15 px-2.5 py-1.5 text-white focus:outline-none">
                <input type="text" id="quickCfgYoutube" oninput="syncQuickAdminChanges()" placeholder="Link do YouTube" class="w-full rounded-lg bg-white/10 border border-white/15 px-2.5 py-1.5 text-white focus:outline-none">
            </div>

            <div class="pt-2 border-t border-white/10">
                <label class="block font-bold uppercase text-slate-300 mb-1">Posição do Botão Flutuante WhatsApp</label>
                <input type="range" id="quickWaPosSlider" min="16" max="220" value="24" oninput="moveFloatingWhatsappPosition(this.value)">
                <div class="flex justify-between text-[10px] text-slate-400 mt-0.5">
                    <span>Canto Direito</span>
                    <span>Mais ao Centro</span>
                </div>
            </div>

            <div class="pt-2 flex gap-2">
                <button type="button" onclick="saveDirectEditsToStorage()" class="flex-1 bg-brand-green hover:bg-brand-greenLight text-white font-bold py-2.5 rounded-xl shadow transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-floppy-disk"></i> Salvar Tudo
                </button>
                <button type="button" onclick="toggleView('admin')" class="bg-white/15 hover:bg-white/25 text-white font-semibold px-3 py-2.5 rounded-xl transition">
                    Painel Completo
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER / NAVBAR -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo (Recreated faithfully from attached LOGO COMPLETA.jpg) -->
            <a href="#inicio" onclick="toggleView('public')" class="flex items-center gap-3 group focus:outline-none">
                <svg class="w-12 h-12 sm:w-14 sm:h-14 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 120 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Left House Outline (Dark Blue #0F3156) -->
                    <path d="M16 55L56 20C59.5 17 63.5 17 67 20L76 28" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M27 47V84C27 91 32 95 39 95H43C49 95 53 91 53 84V76" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <!-- Rising Trend Arrow (Dark Blue #0F3156) -->
                    <path d="M44 59L59 45L71 55L98 27" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M83 25H100V42" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <!-- Right Rising Bars Forming House Base (Emerald Green #138A59) -->
                    <path d="M55 95H90C96 95 100 91 100 84V47L93 40" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M67 95V68" stroke="#138A59" stroke-width="10" stroke-linecap="round"/>
                    <path d="M83 95V58" stroke="#138A59" stroke-width="10" stroke-linecap="round"/>
                    <!-- Upward Arrow Tip on Green Bar -->
                    <path d="M100 47L107 54" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div class="flex flex-col leading-none">
                    <span class="font-display font-extrabold text-2xl sm:text-[26px] tracking-tight text-brand-blue">financie</span>
                    <span class="font-display font-extrabold text-2xl sm:text-[26px] tracking-tight text-brand-green -mt-1.5">suaobra</span>
                    <span class="font-sans font-semibold text-[11px] text-brand-blue self-end -mt-1">.com.br</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav id="publicNav" class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-700">
                <a href="#modalidades" class="hover:text-brand-green transition">Modalidades Caixa</a>
                <a href="#vantagens" class="hover:text-brand-green transition">Construir vs. Comprar</a>
                <a href="#grupo" class="hover:text-brand-green transition">O Grupo</a>
                <a href="#simulador" class="text-brand-blue hover:text-brand-green transition flex items-center gap-1.5">
                    <i class="fa-solid fa-calculator text-brand-green"></i> Simulador de Crédito
                </a>
                <a href="#obras" class="hover:text-brand-green transition">Obras Financiadas</a>
            </nav>

            <!-- CTA & Mobile Menu Button -->
            <div class="flex items-center gap-3">
                <a href="#" id="headerWhatsappBtn" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 bg-brand-green hover:bg-brand-greenDark text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-md shadow-brand-green/20 transition transform hover:-translate-y-0.5">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
                    <span>Falar com Especialista</span>
                </a>
                <button onclick="toggleMobileMenu()" class="lg:hidden p-2.5 rounded-xl text-brand-blue hover:bg-brand-ice focus:outline-none" aria-label="Abrir Menu">
                    <i class="fa-solid fa-bars text-xl" id="mobileMenuIcon"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#modalidades" onclick="toggleMobileMenu()" class="block py-2 px-3 rounded-lg font-semibold text-slate-700 hover:bg-brand-ice hover:text-brand-green">Modalidades Caixa</a>
            <a href="#vantagens" onclick="toggleMobileMenu()" class="block py-2 px-3 rounded-lg font-semibold text-slate-700 hover:bg-brand-ice hover:text-brand-green">Vantagens de Construir</a>
            <a href="#grupo" onclick="toggleMobileMenu()" class="block py-2 px-3 rounded-lg font-semibold text-slate-700 hover:bg-brand-ice hover:text-brand-green">Grupo Geminadas.com & Level</a>
            <a href="#simulador" onclick="toggleMobileMenu()" class="block py-2 px-3 rounded-lg font-semibold text-brand-blue bg-brand-ice/70">Simulador de Crédito Caixa</a>
            <a href="#obras" onclick="toggleMobileMenu()" class="block py-2 px-3 rounded-lg font-semibold text-slate-700 hover:bg-brand-ice hover:text-brand-green">Obras Realizadas</a>
            <div class="pt-2 flex flex-col gap-2">
                <button onclick="toggleMobileMenu(); toggleView('admin');" class="w-full py-2.5 px-4 rounded-xl font-semibold text-sm bg-slate-100 text-brand-blue flex items-center justify-center gap-2">
                    <i class="fa-solid fa-sliders"></i> Acessar Painel Admin
                </button>
                <a href="#" id="mobileWhatsappBtn" target="_blank" rel="noopener noreferrer" class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-brand-green text-white flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-brands fa-whatsapp text-lg"></i> Falar no WhatsApp Agora
                </a>
            </div>
        </div>
    </header>

    <!-- ========================================== -->
    <!-- PUBLIC WEBSITE VIEW                        -->
    <!-- ========================================== -->
    <main id="publicView">

        <!-- HERO SECTION -->
        <section id="inicio" class="relative overflow-hidden bg-gradient-to-br from-brand-blueDark via-brand-blue to-[#123d6b] text-white pt-12 pb-20 lg:py-24">
            <!-- Subtle Architectural Grid Background -->
            <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#138A59 1px, transparent 1px), radial-gradient(#ffffff 1px, #0F3156 1px); background-size: 40px 40px;"></div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Column: Copy & Value Proposition -->
                    <div class="lg:col-span-7 space-y-6">
                        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/15 px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium text-emerald-300">
                            <span class="w-2 h-2 rounded-full bg-brand-greenLight animate-ping"></span>
                            <span data-editable="true" id="editBadgeHero">Grupo <strong class="text-white">Geminadas.com</strong> Arquitetura & <strong class="text-white">Level</strong> Construtora</span>
                        </div>
                        
                        <h1 id="heroHeadline" data-editable="true" class="font-display font-extrabold text-3xl sm:text-5xl lg:text-[52px] leading-[1.12] tracking-tight">
                            Construa sua Casa de Médio ou Alto Padrão com <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-brand-greenLight">Recursos da Caixa.</span>
                        </h1>
                        
                        <p id="heroSubheadline" data-editable="true" class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-2xl">
                            Já tem terreno ou quer adquirir <strong>Terreno + Construção</strong> em um único contrato? Da aprovação do crédito e projeto arquitetônico autoral até a entrega das chaves, você economiza até <strong>30%</strong> em relação a comprar um imóvel pronto.
                        </p>

                        <!-- Hero Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                            <a href="#simulador" class="inline-flex items-center justify-center gap-3 bg-brand-green hover:bg-brand-greenLight text-white font-bold px-7 py-4 rounded-2xl shadow-lg shadow-brand-green/30 transition transform hover:-translate-y-0.5 text-base">
                                <i class="fa-solid fa-calculator"></i>
                                <span>Simular Meu Crédito Agora</span>
                            </a>
                            <a href="#" id="heroWhatsappBtn" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-white text-brand-blue hover:bg-emerald-50 font-bold px-7 py-4 rounded-2xl shadow-lg transition transform hover:-translate-y-0.5 text-base">
                                <i class="fa-brands fa-whatsapp text-brand-green text-xl"></i>
                                <span id="heroWhatsappLabel">WhatsApp Especialista</span>
                            </a>
                        </div>

                        <!-- Quick Connect Bar: Social Media & Official Channels on Homepage -->
                        <div class="pt-3 flex flex-wrap items-center gap-3">
                            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-300 flex items-center gap-1.5">
                                <i class="fa-solid fa-share-nodes"></i> Siga e Acompanhe Nossas Obras:
                            </span>
                            <div id="heroSocialBadges" class="flex flex-wrap items-center gap-2">
                                <!-- Populated dynamically via JS from Admin Settings -->
                            </div>
                        </div>

                        <!-- Key Trust Metrics -->
                        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/10">
                            <div>
                                <div class="font-display font-extrabold text-2xl sm:text-3xl text-emerald-400" data-editable="true">100%</div>
                                <div class="text-xs sm:text-sm text-slate-300" data-editable="true">Chave na Mão: Crédito + Projeto + Obra</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: INTERACTIVE LIVE COMPARATOR & SLIDER WIDGET DIRECTLY ON HERO -->
                    <div class="lg:col-span-5">
                        <div id="heroInteractiveWidget" class="bg-white rounded-3xl p-6 sm:p-7 text-slate-800 shadow-2xl border-2 border-emerald-400/40 relative transition-all">
                            <!-- Floating Interactive Badge -->
                            <div class="absolute -top-3.5 right-6 bg-brand-green text-white text-[11px] font-bold px-3.5 py-1 rounded-full shadow-md flex items-center gap-1.5">
                                <i class="fa-solid fa-sliders"></i> Arraste a Barra ou Edite o Valor
                            </div>

                            <!-- Header with Editable Area & Title -->
                            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                                <div>
                                    <span class="text-[11px] font-bold uppercase tracking-wider text-brand-green flex items-center gap-1">
                                        <i class="fa-solid fa-bolt"></i> Simulador Rápido ao Vivo
                                    </span>
                                    <h3 class="font-display font-extrabold text-lg sm:text-xl text-brand-blue flex flex-wrap items-center gap-1.5 mt-0.5">
                                        <span data-editable="true" id="heroCardTitleText">Casa Alto Padrão</span>
                                        <span id="heroCardSqmBadge" class="bg-brand-ice text-brand-green text-xs font-extrabold px-2.5 py-0.5 rounded-lg border border-brand-green/20">(~220 m²)</span>
                                    </h3>
                                </div>
                                <div class="bg-brand-ice p-2.5 rounded-2xl text-brand-blue shrink-0">
                                    <i class="fa-solid fa-building-columns text-xl"></i>
                                </div>
                            </div>

                            <!-- INTERACTIVE SLIDER 1: ORÇAMENTO CONSTRUINDO CONOSCO (EDITABLE INPUT + SLIDER) -->
                            <div class="mb-4 p-3.5 rounded-2xl bg-brand-ice/90 border border-slate-200/90">
                                <div class="flex justify-between items-center mb-1.5">
                                    <label for="heroCostSlider" class="text-xs font-bold text-brand-blue flex items-center gap-1">
                                        <i class="fa-solid fa-arrows-left-right text-brand-green"></i> Seu Investimento (Terreno + Obra):
                                    </label>
                                    <div class="flex items-center bg-white border border-brand-green/40 rounded-lg px-2 py-0.5 shadow-sm">
                                        <span class="text-xs font-bold text-brand-green mr-1">R$</span>
                                        <input type="text" id="heroCostInputDirect" value="1.020.000" onchange="handleHeroDirectInput(this.value)" class="w-24 text-right font-display font-extrabold text-sm text-brand-blue focus:outline-none" title="Clique para digitar qualquer valor até R$ 2.250.000 (Teto SFH)">
                                    </div>
                                </div>
                                <input type="range" id="heroCostSlider" min="300000" max="2250000" step="10000" value="1020000" oninput="updateHeroInteractiveCard()" class="w-full">
                                <div class="flex justify-between text-[10px] font-semibold text-slate-400 mt-1">
                                    <span>R$ 300 mil</span>
                                    <span class="text-brand-green font-bold">◄ Arraste a barra ►</span>
                                    <span class="text-brand-blue font-bold">R$ 2,25 mi (Teto SFH)</span>
                                </div>
                            </div>

                            <!-- INTERACTIVE SLIDER 2: PERCENTUAL FINANCIADO PELA CAIXA VS ENTRADA -->
                            <div class="mb-4 px-3 py-2.5 rounded-2xl bg-slate-50 border border-slate-200/70">
                                <div class="flex justify-between items-center text-xs mb-1">
                                    <span class="font-semibold text-slate-600">Cota Financiada Caixa: <strong id="heroQuotaLabel" class="text-brand-blue">80%</strong></span>
