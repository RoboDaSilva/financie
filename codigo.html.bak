                                <button type="button" onclick="setSimStandard('medio')" id="stdMedio" class="py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:border-brand-blue transition">
                                    Médio Padrão
                                </button>
                                <button type="button" onclick="setSimStandard('alto')" id="stdAlto" class="py-2.5 px-3 rounded-xl border-2 border-brand-blue bg-brand-blue text-white text-xs sm:text-sm font-bold transition">
                                    Alto Padrão
                                </button>
                                <button type="button" onclick="setSimStandard('luxo')" id="stdLuxo" class="py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:border-brand-blue transition">
                                    Alto Luxo
                                </button>
                            </div>
                        </div>

                        <!-- 3. Sliders for Values -->
                        <div class="space-y-6">
                            <!-- SFH Ceiling Badge -->
                            <div class="p-3 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2 text-xs font-bold text-brand-blue">
                                    <i class="fa-solid fa-shield-halved text-brand-green text-sm"></i>
                                    <span>Teto SFH Caixa: <strong>R$ 2,25 milhões</strong> (uso de FGTS e taxas reduzidas)</span>
                                </div>
                                <span id="sfhLimitBadge" class="hidden text-[10px] font-extrabold uppercase bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full shrink-0">
                                    Limite SFH Atingido
                                </span>
                            </div>

                            <!-- Valor do Terreno -->
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <label for="simTerrenoRange" class="text-sm font-semibold text-slate-700" id="labelTerreno">Valor do Terreno Desejado:</label>
                                    <span id="simTerrenoDisplay" class="font-display font-extrabold text-lg text-brand-blue">R$ 250.000</span>
                                </div>
                                <input type="range" id="simTerrenoRange" min="80000" max="1500000" step="10000" value="250000" oninput="updateSimulation('terreno')">
                                <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                                    <span>R$ 80 mil</span>
                                    <span>R$ 1,5 milhão</span>
                                </div>
                            </div>

                            <!-- Valor da Construção / Obra -->
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <label for="simObraRange" class="text-sm font-semibold text-slate-700">Orçamento Estimado para a Construção:</label>
                                    <div class="text-right">
                                        <span id="simObraDisplay" class="font-display font-extrabold text-lg text-brand-green">R$ 550.000</span>
                                        <span id="simAreaEstimada" class="block text-[11px] text-slate-500">Área aprox. sugerida: ~155 m²</span>
                                    </div>
                                </div>
                                <input type="range" id="simObraRange" min="200000" max="2050000" step="10000" value="550000" oninput="updateSimulation('obra')">
                                <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                                    <span>R$ 200 mil</span>
                                    <span>Teto Global (Terreno + Obra): R$ 2,25 milhões</span>
                                </div>
                            </div>

                            <!-- Recursos Próprios + FGTS -->
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <label for="simEntradaRange" class="text-sm font-semibold text-slate-700">Entrada em Dinheiro + Saldo FGTS:</label>
                                    <span id="simEntradaDisplay" class="font-display font-extrabold text-lg text-brand-blue">R$ 160.000</span>
                                </div>
                                <input type="range" id="simEntradaRange" min="0" max="1000000" step="10000" value="160000" oninput="updateSimulation()">
                                <p id="simEntradaNotice" class="text-xs text-slate-500 mt-1">
                                    * A Caixa financia até 80% do valor global. Na modalidade Terreno Próprio, o lote quitado já abatido pode cobrir 100% da entrada exigida.
                                </p>
                            </div>

                            <!-- Prazo e Amortização -->
                            <div class="grid sm:grid-cols-2 gap-4 pt-2">
                                <div>
                                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1.5">Prazo (Meses)</label>
                                    <select id="simPrazoSelect" onchange="updateSimulation()" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm font-semibold text-brand-blue focus:outline-none focus:border-brand-green">
                                        <option value="420" selected>420 meses (35 anos)</option>
                                        <option value="360">360 meses (30 anos)</option>
                                        <option value="300">300 meses (25 anos)</option>
                                        <option value="240">240 meses (20 anos)</option>
                                        <option value="180">180 meses (15 anos)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1.5">Nome (Opcional p/ WhatsApp)</label>
                                    <input type="text" id="simClientName" placeholder="Ex: Dr. Rodrigo Silva" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:border-brand-green">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side: Real-Time Calculation Results -->
                    <div class="lg:col-span-5 bg-brand-blue text-white p-6 sm:p-10 flex flex-col justify-between relative">
                        <div>
                            <div class="flex items-center justify-between border-b border-white/15 pb-4 mb-6">
                                <div>
                                    <span class="text-xs uppercase tracking-wider text-emerald-300 font-bold">Resumo da Simulação (Teto SFH R$ 2,25 mi)</span>
                                    <h3 class="font-display font-bold text-xl">Viabilidade Caixa Econômica</h3>
                                </div>
                                <i class="fa-solid fa-file-invoice-dollar text-2xl text-emerald-400"></i>
                            </div>

                            <div class="space-y-4">
                                <div class="flex justify-between items-center text-sm">
                                    <span class="text-slate-300">Investimento Total (Terreno + Obra):</span>
                                    <span id="resTotalProject" class="font-bold text-base">R$ 800.000,00</span>
                                </div>

                                <div class="bg-white/10 rounded-2xl p-4 border border-white/15">
                                    <div class="text-xs text-emerald-300 font-medium">Crédito Liberado pela Caixa (Financiado):</div>
                                    <div id="resFinancedAmount" class="font-display font-extrabold text-3xl text-white mt-0.5">R$ 640.000,00</div>
                                    <div id="resEntrySummary" class="text-xs text-slate-300 mt-1">Entrada + FGTS: R$ 160.000,00 (20%)</div>
                                </div>

                                <div class="grid grid-cols-2 gap-3">
                                    <div class="bg-white/5 rounded-xl p-3.5 border border-white/10">
                                        <div class="text-[11px] text-slate-300">1ª Parcela Estimada (SAC)</div>
                                        <div id="resFirstInstallment" class="font-display font-bold text-lg text-emerald-300 mt-0.5">R$ 6.320</div>
                                    </div>
                                    <div class="bg-white/5 rounded-xl p-3.5 border border-white/10">
                                        <div class="text-[11px] text-slate-300">Última Parcela Estimada</div>
                                        <div id="resLastInstallment" class="font-display font-bold text-lg text-white mt-0.5">R$ 1.560</div>
                                    </div>
                                </div>

                                <div class="flex justify-between items-center text-xs sm:text-sm pt-2 border-t border-white/10">
                                    <span class="text-slate-300">Renda Familiar Bruta Recomendada:</span>
                                    <span id="resRequiredIncome" class="font-bold text-emerald-300">R$ 21.000/mês</span>
                                </div>

                                <!-- Equity Valuation Highlight -->
                                <div class="bg-gradient-to-r from-brand-greenDark to-brand-green rounded-2xl p-4 mt-4 shadow-inner">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-bold uppercase tracking-wider text-emerald-100">Valor de Mercado Após Pronta</span>
                                        <span class="bg-white/20 text-white text-[11px] font-bold px-2 py-0.5 rounded-md">+28% Valorização</span>
                                    </div>
                                    <div id="resMarketValuation" class="font-display font-extrabold text-2xl text-white mt-1">R$ 1.024.000,00</div>
                                    <div id="resNetEquityGain" class="text-xs text-emerald-100 mt-0.5">Lucro patrimonial imediato estimado: <strong>+ R$ 224.000,00</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 space-y-3">
                            <button type="button" onclick="sendSimulationToWhatsApp()" class="w-full py-4 px-6 rounded-2xl bg-brand-green hover:bg-brand-greenLight text-white font-display font-bold text-base shadow-lg shadow-brand-green/40 transition flex items-center justify-center gap-2.5">
                                <i class="fa-brands fa-whatsapp text-xl"></i>
                                <span>Receber Estudo Completo no WhatsApp</span>
                            </button>
                            <p class="text-[11px] text-center text-slate-300">
                                Simulação referencial baseada nas taxas SBPE/Caixa vigentes (<span id="resRateDisplay">9,89%</span> a.a. + TR). Aprovação sujeita à análise de crédito.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- PORTFÓLIO DE OBRAS FINANCIADAS (COM FOTOS E PLANTA BAIXA) -->
        <section id="obras" class="py-16 lg:py-24 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
                    <div>
                        <span class="inline-block bg-brand-blue/10 text-brand-blue font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-3">
                            Portfólio Realizado
                        </span>
                        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-brand-blue">
                            Obras Construídas com Financiamento Caixa
                        </h2>
                        <p class="text-slate-600 mt-2 max-w-2xl">
                            Confira casas de médio e alto padrão projetadas pela <strong>Geminadas.com</strong> e executadas pela <strong>Level Construtora</strong> através da <strong>financiesuaobra.com.br</strong>. Clique para ver <strong>Fotos e Planta Baixa</strong>.
                        </p>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="flex flex-wrap gap-2">
                        <button onclick="filterProjects('all')" id="filter-all" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition">
                            Todas as Obras
                        </button>
                        <button onclick="filterProjects('Terreno + Construção')" id="filter-tc" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-brand-ice text-slate-700 hover:bg-slate-200 transition">
                            Terreno + Construção
                        </button>
                        <button onclick="filterProjects('Construção em Terreno Próprio')" id="filter-tp" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-brand-ice text-slate-700 hover:bg-slate-200 transition">
                            Terreno Próprio
                        </button>
                    </div>
                </div>

                <!-- Dynamic Projects Grid -->
                <div id="projectsGrid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Populated via JS -->
                </div>

                <!-- Admin Quick Shortcut Banner -->
                <div class="mt-14 bg-brand-ice rounded-3xl p-6 sm:p-8 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-brand-blue text-white flex items-center justify-center text-xl shrink-0">
                            <i class="fa-solid fa-folder-plus"></i>
                        </div>
                        <div>
                            <h4 class="font-display font-bold text-lg text-brand-blue">É gestor da financiesuaobra.com.br?</h4>
                            <p class="text-sm text-slate-600">Cadastre novas obras entregues, plantas baixas, fotos e personalize o WhatsApp e redes sociais no Painel Admin.</p>
                        </div>
                    </div>
                    <button onclick="toggleView('admin')" class="shrink-0 bg-white hover:bg-brand-blue hover:text-white text-brand-blue border border-brand-blue font-bold text-sm px-5 py-3 rounded-xl transition flex items-center gap-2">
                        <i class="fa-solid fa-sliders"></i> Gerenciar Obras no Admin
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- ========================================== -->
    <!-- ADMIN PANEL VIEW (CUSTOMIZATION & CMS)     -->
    <!-- ========================================== -->
    <section id="adminView" class="hidden min-h-screen bg-brand-ice py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto space-y-8">
            
            <!-- Admin Header -->
            <div class="bg-brand-blue text-white rounded-3xl p-6 sm:p-8 shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <div class="inline-flex items-center gap-2 bg-brand-green px-3 py-1 rounded-full text-xs font-bold mb-2">
                        <i class="fa-solid fa-shield-halved"></i> Painel Administrativo • Personalização em Tempo Real
                    </div>
                    <h1 class="font-display font-extrabold text-2xl sm:text-3xl">Gestão financiesuaobra.com.br</h1>
                    <p class="text-slate-300 text-sm mt-1">Configure abaixo o WhatsApp, Instagram, Facebook, YouTube, Ícone da Aba do Site (Favicon) e cadastre suas Obras Financiadas.</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <button type="button" onclick="exportBackupJson()" class="bg-white/10 hover:bg-white/20 text-white font-semibold text-xs px-4 py-3 rounded-xl transition flex items-center gap-2" title="Baixar Backup dos Dados">
                        <i class="fa-solid fa-download"></i> Exportar Backup
                    </button>
                    <label class="cursor-pointer bg-white/10 hover:bg-white/20 text-white font-semibold text-xs px-4 py-3 rounded-xl transition flex items-center gap-2" title="Restaurar Backup">
                        <i class="fa-solid fa-upload"></i> Importar
                        <input type="file" accept=".json" class="hidden" onchange="importBackupJson(event)">
                    </label>
                    <button onclick="toggleView('public')" class="bg-white text-brand-blue hover:bg-emerald-50 font-bold text-sm px-5 py-3 rounded-xl shadow transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-eye text-brand-green"></i> Ver Site Público
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- BLOCO 1 (SEMPRE VISÍVEL NO TOPO): WHATSAPP, REDES SOCIAIS E ÍCONE DA ABA  -->
            <!-- ========================================================================= -->
            <form onsubmit="saveSiteConfig(event)" class="bg-white rounded-3xl p-6 sm:p-8 shadow-md border-2 border-brand-green/30 space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-brand-green">Configuração Rápida da Página Inicial e Navegador</span>
                        <h2 class="font-display font-extrabold text-xl sm:text-2xl text-brand-blue flex items-center gap-2 mt-0.5">
                            <i class="fa-solid fa-sliders text-brand-green"></i> 1. Personalizar WhatsApp, Instagram, Facebook, YouTube e Ícone da Aba
                        </h2>
                    </div>
                    <button type="submit" class="bg-brand-green hover:bg-brand-greenDark text-white font-display font-bold text-sm px-6 py-3.5 rounded-xl shadow-md shadow-brand-green/20 transition flex items-center justify-center gap-2 shrink-0">
                        <i class="fa-solid fa-floppy-disk"></i> Salvar Alterações Agora
                    </button>
                </div>

                <div class="grid lg:grid-cols-12 gap-6">
                    
                    <!-- Coluna Esquerda (7 cols): WhatsApp e Redes Sociais -->
                    <div class="lg:col-span-7 space-y-5">
                        <!-- WhatsApp Box -->
                        <div class="p-4 sm:p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200 space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="font-display font-bold text-sm text-brand-blue flex items-center gap-2">
                                    <i class="fa-brands fa-whatsapp text-brand-green text-lg"></i> WhatsApp Oficial do Site e Simulador
                                </h3>
                                <span class="text-[11px] font-bold bg-brand-green text-white px-2.5 py-0.5 rounded-full">Ativo na Home</span>
                            </div>
                            <div class="grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold uppercase text-brand-blue mb-1">Número com DDD (Somente números) *</label>
                                    <input type="text" id="cfgWhatsapp" required placeholder="5544999999999" oninput="updateLiveAdminPreview()" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-brand-blue focus:outline-none focus:border-brand-green">
                                    <span class="text-[11px] text-slate-500">Ex: 5544999999999 (Código 55 + DDD + Número)</span>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-brand-blue mb-1">Exibição Formatada no Site *</label>
                                    <input type="text" id="cfgPhoneDisplay" placeholder="(44) 99999-9999" oninput="updateLiveAdminPreview()" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-700 focus:outline-none focus:border-brand-green">
                                    <span class="text-[11px] text-slate-500">Aparece no topo, botão da Home e rodapé</span>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-brand-blue mb-1">Mensagem Padrão ao Clicar no Botão de WhatsApp</label>
                                <input type="text" id="cfgWhatsappMsg" placeholder="Olá! Vim pelo site financiesuaobra.com.br e quero simular minha construção financiada." class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs text-slate-700 focus:outline-none focus:border-brand-green">
                            </div>
                        </div>

                        <!-- Redes Sociais Box (Instagram, Facebook, YouTube) -->
                        <div class="p-4 sm:p-5 rounded-2xl bg-brand-ice border border-slate-200 space-y-4">
                            <h3 class="font-display font-bold text-sm text-brand-blue flex items-center gap-2">
                                <i class="fa-solid fa-share-nodes text-brand-blue"></i> Links das Redes Sociais (Aparecem no Topo, Hero Inicial e Rodapé)
                            </h3>
                            <div class="grid sm:grid-cols-3 gap-3">
                                <div>
                                    <label class="block text-xs font-bold uppercase text-slate-700 mb-1 flex items-center gap-1.5">
                                        <i class="fa-brands fa-instagram text-pink-600 text-base"></i> Instagram
                                    </label>
                                    <input type="text" id="cfgInstagram" placeholder="https://instagram.com/financiesuaobra" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs focus:outline-none focus:border-brand-green">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-slate-700 mb-1 flex items-center gap-1.5">
                                        <i class="fa-brands fa-facebook text-blue-600 text-base"></i> Facebook
                                    </label>
                                    <input type="text" id="cfgFacebook" placeholder="https://facebook.com/financiesuaobra" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs focus:outline-none focus:border-brand-green">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-slate-700 mb-1 flex items-center gap-1.5">
                                        <i class="fa-brands fa-youtube text-red-600 text-base"></i> YouTube
                                    </label>
                                    <input type="text" id="cfgYoutube" placeholder="https://youtube.com/@financiesuaobra" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs focus:outline-none focus:border-brand-green">
                                </div>
                            </div>
                        </div>

                        <!-- Parâmetros Extras (Taxa de Juros, E-mail e Endereço) -->
                        <div class="grid sm:grid-cols-3 gap-3">
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-500 mb-1">Taxa Juros Simulador (% a.a.)</label>
                                <input type="number" step="0.01" id="cfgInterestRate" placeholder="9.89" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-brand-blue focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-500 mb-1">E-mail Comercial</label>
                                <input type="email" id="cfgEmail" placeholder="contato@financiesuaobra.com.br" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-500 mb-1">Localização / Grupo</label>
                                <input type="text" id="cfgAddress" placeholder="Grupo Geminadas.com & Level Construtora" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs focus:outline-none focus:border-brand-green">
                            </div>
                        </div>
                    </div>

                    <!-- Coluna Direita (5 cols): Ícone da Aba do Site (Favicon) + Título da Aba -->
                    <div class="lg:col-span-5 p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-4">
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="font-display font-bold text-sm text-brand-blue flex items-center gap-2">
                                    <i class="fa-solid fa-window-maximize text-brand-green"></i> Ícone da Aba do Site (Favicon) e Título
                                </h3>
                                <span class="text-[11px] font-semibold text-slate-500">Aba do Navegador</span>
                            </div>

                            <!-- Simulação Visual em Tempo Real da Aba do Navegador -->
                            <div class="bg-slate-200 p-2.5 rounded-2xl border border-slate-300">
                                <div class="text-[10px] font-bold uppercase text-slate-500 mb-1.5 px-1">Preview ao Vivo da Aba do Navegador:</div>
                                <div class="bg-white rounded-xl px-3.5 py-2.5 shadow-sm flex items-center justify-between gap-2 border border-slate-200/80">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <img id="browserTabFaviconPreview" src="" alt="Favicon" class="w-5 h-5 object-contain shrink-0">
                                        <span id="browserTabTitlePreview" class="text-xs font-semibold text-slate-700 truncate">financiesuaobra.com.br | Construção Financiada Caixa</span>
                                    </div>
                                    <i class="fa-solid fa-xmark text-slate-400 text-xs shrink-0"></i>
                                </div>
                            </div>

                            <!-- Título da Aba do Site -->
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Título da Aba do Navegador</label>
                                <input type="text" id="cfgPageTitle" oninput="updateLiveAdminPreview()" placeholder="financiesuaobra.com.br | Construção Financiada Caixa" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-medium focus:outline-none focus:border-brand-green">
                            </div>

                            <!-- Opções de Ícone da Aba (Logo Oficial, Upload ou URL) -->
                            <div class="space-y-2">
                                <label class="block text-xs font-bold uppercase text-slate-600">Escolher Ícone da Aba (Favicon):</label>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" onclick="useOfficialLogoFavicon()" class="px-3 py-2 rounded-xl bg-brand-blue hover:bg-brand-blueLight text-white text-xs font-bold transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-Rotate-left"></i> Usar Logo Oficial (Casa + Gráfico)
                                    </button>
                                    <label class="cursor-pointer px-3 py-2 rounded-xl bg-brand-green hover:bg-brand-greenDark text-white text-xs font-bold transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-upload"></i> Enviar Ícone (PNG/JPG/SVG)
                                        <input type="file" accept="image/*" class="hidden" onchange="handleFaviconUpload(event)">
                                    </label>
                                </div>
                                <input type="text" id="cfgFaviconUrl" oninput="updateLiveAdminPreview()" placeholder="Ou cole aqui a URL do ícone (ou Base64 gerado no botão acima)" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-[11px] text-slate-600 focus:outline-none focus:border-brand-green">
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
                            <span>Título Hero Opcional:</span>
                            <input type="text" id="cfgHeroTitle" placeholder="Construa sua Casa de Médio ou Alto Padrão..." class="w-2/3 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs focus:outline-none focus:border-brand-green">
                        </div>
                    </div>

                </div>
            </form>

            <!-- ========================================================================= -->
            <!-- BLOCO 2: CADASTRAR E GERENCIAR OBRAS FINANCIADAS (FOTOS E PLANTA BAIXA)   -->
            <!-- ========================================================================= -->
            <div id="adminTabObras" class="grid lg:grid-cols-12 gap-8">
                
                <!-- Left Column: Form to Add/Edit Project -->
                <div class="lg:col-span-5 bg-white rounded-3xl p-6 sm:p-8 shadow-md border border-slate-200/80 h-fit">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
                        <h3 id="formProjectTitle" class="font-display font-extrabold text-xl text-brand-blue flex items-center gap-2">
                            <i class="fa-solid fa-plus-circle text-brand-green"></i> 2. Cadastrar Obra Financiada
                        </h3>
                        <button type="button" id="cancelEditBtn" onclick="resetProjectForm()" class="hidden text-xs font-bold text-red-600 hover:underline">
                            Cancelar Edição
                        </button>
                    </div>

                    <form id="projectForm" onsubmit="saveProject(event)" class="space-y-4">
                        <input type="hidden" id="projId">

                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Título da Obra / Residência *</label>
                            <input type="text" id="projTitle" required placeholder="Ex: Residência Aurora - Condomínio Alphaville" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Modalidade Caixa *</label>
                                <select id="projModality" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium focus:outline-none focus:border-brand-green">
                                    <option value="Terreno + Construção">Terreno + Construção</option>
                                    <option value="Construção em Terreno Próprio">Terreno Próprio</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Padrão Construtivo *</label>
                                <select id="projStandard" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium focus:outline-none focus:border-brand-green">
                                    <option value="Alto Padrão">Alto Padrão</option>
                                    <option value="Médio Padrão">Médio Padrão</option>
                                    <option value="Alto Luxo">Alto Luxo</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Cidade / Condomínio *</label>
                                <input type="text" id="projLocation" required placeholder="Ex: Cond. Jardins / Maringá" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Prazo de Obra (Level)</label>
                                <input type="text" id="projTimeline" placeholder="Ex: 10 meses" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                        </div>

                        <div class="grid grid-cols-4 gap-2">
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Área (m²)*</label>
                                <input type="number" id="projArea" required placeholder="210" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Lote (m²)</label>
                                <input type="number" id="projLotArea" placeholder="360" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Quartos/Suítes</label>
                                <input type="text" id="projBeds" placeholder="3 Suítes" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase text-slate-600 mb-1">Vagas</label>
                                <input type="number" id="projGarage" placeholder="2" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Valor Financiado / Custo (R$)*</label>
                                <input type="number" id="projCost" required placeholder="850000" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Avaliação Pronta (R$)</label>
                                <input type="number" id="projValuation" placeholder="1150000" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                            </div>
                        </div>

                        <!-- Foto da Obra (URL ou Upload Local) -->
                        <div class="p-3.5 rounded-2xl bg-brand-ice border border-slate-200 space-y-2">
                            <label class="block text-xs font-bold uppercase text-brand-blue">
                                <i class="fa-solid fa-camera text-brand-green mr-1"></i> Foto Principal da Obra Pronta
                            </label>
                            <input type="text" id="projPhotoUrl" placeholder="Cole a URL da foto ou envie o arquivo abaixo" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:border-brand-green">
                            <div class="flex items-center gap-2">
                                <label class="cursor-pointer bg-brand-blue hover:bg-brand-blueLight text-white text-xs font-semibold px-3 py-2 rounded-lg transition inline-flex items-center gap-1.5">
                                    <i class="fa-solid fa-upload"></i> Enviar Foto do Computador/Celular
                                    <input type="file" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'projPhotoUrl', 'previewPhoto')">
                                </label>
                                <img id="previewPhoto" src="" alt="Preview" class="hidden w-10 h-10 object-cover rounded-lg border border-slate-300">
                            </div>
                        </div>

                        <!-- Planta Baixa (URL ou Upload Local) -->
                        <div class="p-3.5 rounded-2xl bg-brand-ice border border-slate-200 space-y-2">
                            <label class="block text-xs font-bold uppercase text-brand-blue">
                                <i class="fa-solid fa-Drafting-compass text-brand-green mr-1"></i> Imagem da Planta Baixa (Geminadas.com)
                            </label>
                            <input type="text" id="projFloorplanUrl" placeholder="Cole a URL da planta baixa ou envie o arquivo abaixo" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:border-brand-green">
                            <div class="flex items-center gap-2">
                                <label class="cursor-pointer bg-brand-green hover:bg-brand-greenDark text-white text-xs font-semibold px-3 py-2 rounded-lg transition inline-flex items-center gap-1.5">
                                    <i class="fa-solid fa-upload"></i> Enviar Planta Baixa
                                    <input type="file" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'projFloorplanUrl', 'previewFloorplan')">
                                </label>
                                <img id="previewFloorplan" src="" alt="Preview Planta" class="hidden w-10 h-10 object-cover rounded-lg border border-slate-300">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Informações da Construção & Memorial Resumido *</label>
                            <textarea id="projDescription" rows="3" required placeholder="Descreva os diferenciais da obra: pé-direito duplo, área gourmet integrada, piscina aquecida, esquadrias automatizadas, projeto Geminadas.com e execução Level Construtora..." class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm focus:outline-none focus:border-brand-green"></textarea>
                        </div>

                        <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-brand-green hover:bg-brand-greenDark text-white font-display font-bold text-sm shadow-md transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-floppy-disk"></i>
                            <span id="submitProjectBtnText">Salvar e Publicar Obra no Site</span>
                        </button>
                    </form>
                </div>

                <!-- Right Column: List of Registered Projects -->
                <div class="lg:col-span-7 space-y-4">
                    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-md border border-slate-200/80">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="font-display font-extrabold text-xl text-brand-blue">Obras Cadastradas no Portfólio</h3>
                                <p class="text-xs text-slate-500">Gerencie, edite ou exclua as obras que aparecem na página inicial.</p>
                            </div>
                            <span id="adminProjectsCount" class="bg-brand-ice text-brand-blue font-bold text-xs px-3 py-1.5 rounded-full">3 obras</span>
                        </div>

                        <div id="adminProjectsList" class="space-y-4">
                            <!-- Populated via JS -->
                        </div>
                    </div>
                </div>

            </div>

            <!-- TAB 2: CONFIGURAÇÕES GERAIS, WHATSAPP E REDES SOCIAIS -->
            <div id="adminTabConfig" class="hidden">
                <form onsubmit="saveSiteConfig(event)" class="bg-white rounded-3xl p-6 sm:p-10 shadow-md border border-slate-200/80 max-w-4xl mx-auto space-y-8">
                    <div class="border-b border-slate-100 pb-4">
                        <h3 class="font-display font-extrabold text-2xl text-brand-blue">Personalização Total do Site</h3>
                        <p class="text-sm text-slate-500 mt-1">Configure o número oficial de WhatsApp, redes sociais do grupo e parâmetros do simulador que aparecem na página inicial.</p>
                    </div>

                    <!-- WhatsApp & Contact -->
                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase text-brand-blue mb-1.5">
                                <i class="fa-brands fa-whatsapp text-brand-green mr-1"></i> Número do WhatsApp (Com DDD) *
                            </label>
                            <input type="text" id="cfgWhatsapp" required placeholder="5544999999999" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold focus:outline-none focus:border-brand-green">
                            <span class="text-[11px] text-slate-400">Ex: 5544999999999 (Receberá as simulações e contatos do site)</span>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-brand-blue mb-1.5">
                                <i class="fa-solid fa-phone text-brand-blue mr-1"></i> Telefone / Exibição no Rodapé
                            </label>
                            <input type="text" id="cfgPhoneDisplay" placeholder="(44) 99999-9999" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:border-brand-green">
                        </div>
                    </div>

                    <!-- Social Media Links -->
                    <div class="grid sm:grid-cols-3 gap-6 pt-2">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">
                                <i class="fa-brands fa-instagram text-pink-600 mr-1"></i> Link do Instagram
                            </label>
                            <input type="url" id="cfgInstagram" placeholder="https://instagram.com/financiesuaobra" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">
                                <i class="fa-brands fa-facebook text-blue-600 mr-1"></i> Link do Facebook
                            </label>
                            <input type="url" id="cfgFacebook" placeholder="https://facebook.com/financiesuaobra" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">
                                <i class="fa-brands fa-youtube text-red-600 mr-1"></i> Link do YouTube
                            </label>
                            <input type="url" id="cfgYoutube" placeholder="https://youtube.com/@financiesuaobra" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>
                    </div>

                    <!-- Group & Simulator Customization -->
                    <div class="grid sm:grid-cols-3 gap-6 pt-2 border-t border-slate-100">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Taxa Anual Base do Simulador (%)</label>
                            <input type="number" step="0.01" id="cfgInterestRate" placeholder="9.89" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm font-semibold focus:outline-none focus:border-brand-green">
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Endereço do Escritório (Geminadas.com & Level)</label>
                            <input type="text" id="cfgAddress" placeholder="Atendimento Presencial e Online • Grupo Geminadas.com & Level Construtora" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Título Principal (Hero da Página Inicial)</label>
                            <input type="text" id="cfgHeroTitle" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">E-mail de Contato</label>
                            <input type="email" id="cfgEmail" placeholder="contato@financiesuaobra.com.br" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-green">
                        </div>
                    </div>

                    <div class="pt-4 flex justify-end">
                        <button type="submit" class="bg-brand-green hover:bg-brand-greenDark text-white font-display font-bold text-base px-8 py-4 rounded-2xl shadow-lg transition flex items-center gap-2">
                            <i class="fa-solid fa-check-double"></i> Salvar Todas as Configurações
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- PROJECT DETAILS & FLOORPLAN MODAL          -->
    <!-- ========================================== -->
    <div id="projectModal" class="fixed inset-0 z-50 hidden bg-brand-blueDark/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl border border-slate-100 my-8">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-4 bg-brand-blue text-white">
                <div>
                    <span id="modalBadge" class="text-xs font-bold uppercase tracking-wider text-emerald-300">Terreno + Construção</span>
                    <h3 id="modalTitle" class="font-display font-extrabold text-xl sm:text-2xl">Residência Contemporânea</h3>
                </div>
                <button onclick="closeProjectModal()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Switcher: Foto da Obra vs. Planta Baixa -->
            <div class="bg-brand-ice px-6 py-3 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
                <div class="flex gap-2">
                    <button onclick="switchModalMedia('photo')" id="modalBtnPhoto" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition flex items-center gap-2">
                        <i class="fa-solid fa-camera"></i> Foto da Construção
                    </button>
                    <button onclick="switchModalMedia('floorplan')" id="modalBtnFloorplan" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-brand-blue border border-slate-200 hover:border-brand-green transition flex items-center gap-2">
                        <i class="fa-solid fa-compass-drafting text-brand-green"></i> Ver Planta Baixa (Geminadas.com)
                    </button>
                </div>
                <span id="modalLocation" class="text-xs font-semibold text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-location-dot text-brand-green"></i> Condomínio Fechado
                </span>
            </div>

            <!-- Modal Body -->
            <div class="grid md:grid-cols-12">
                <!-- Media Viewer -->
                <div class="md:col-span-7 bg-slate-900 relative flex items-center justify-center min-h-[300px] sm:min-h-[400px]">
                    <img id="modalMainImage" src="" alt="Imagem da Obra" class="w-full h-full max-h-[440px] object-cover">
                    <div id="modalMediaCaption" class="absolute bottom-3 left-3 bg-brand-blueDark/85 backdrop-blur-md text-white text-xs px-3 py-1.5 rounded-lg">
                        Execução: Level Construtora | Projeto: Geminadas.com
                    </div>
                </div>

                <!-- Technical Specs -->
                <div class="md:col-span-5 p-6 flex flex-col justify-between space-y-5">
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-2.5 text-center">
                            <div class="p-3 rounded-xl bg-brand-ice">
                                <div class="text-[11px] text-slate-500 uppercase font-bold">Área Construída</div>
                                <div id="modalArea" class="font-display font-extrabold text-base text-brand-blue">220 m²</div>
                            </div>
                            <div class="p-3 rounded-xl bg-brand-ice">
                                <div class="text-[11px] text-slate-500 uppercase font-bold">Terreno</div>
                                <div id="modalLot" class="font-display font-extrabold text-base text-brand-blue">360 m²</div>
                            </div>
                            <div class="p-3 rounded-xl bg-brand-ice">
                                <div class="text-[11px] text-slate-500 uppercase font-bold">Dormitórios</div>
                                <div id="modalBeds" class="font-display font-extrabold text-base text-brand-blue">3 Suítes</div>
                            </div>
                            <div class="p-3 rounded-xl bg-brand-ice">
                                <div class="text-[11px] text-slate-500 uppercase font-bold">Prazo Level</div>
                                <div id="modalTimeline" class="font-display font-extrabold text-base text-brand-green">10 Meses</div>
                            </div>
                        </div>

                        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200">
                            <div class="flex justify-between text-xs text-slate-600">
                                <span>Custo / Financiamento Caixa:</span>
                                <strong id="modalCost" class="text-brand-blue">R$ 850.000</strong>
                            </div>
                            <div class="flex justify-between text-xs text-slate-600 mt-1">
                                <span>Avaliação de Mercado Pronta:</span>
                                <strong id="modalValuation" class="text-brand-green">R$ 1.150.000</strong>
                            </div>
                        </div>

                        <div>
                            <h4 class="font-display font-bold text-sm text-brand-blue mb-1">Memorial e Detalhes da Construção:</h4>
                            <p id="modalDescription" class="text-xs sm:text-sm text-slate-600 leading-relaxed"></p>
                        </div>
                    </div>

                    <button id="modalWhatsappBtn" type="button" class="w-full py-3.5 px-5 rounded-xl bg-brand-green hover:bg-brand-greenDark text-white font-display font-bold text-sm shadow-md transition flex items-center justify-center gap-2">
                        <i class="fa-brands fa-whatsapp text-lg"></i>
                        <span>Quero Construir um Projeto Similar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-brand-blueDark text-white pt-16 pb-12 border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
                
                <!-- Col 1: Brand & Group -->
                <div class="md:col-span-5 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-white p-2 rounded-2xl inline-flex">
                            <svg class="w-10 h-10" viewBox="0 0 120 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16 55L56 20C59.5 17 63.5 17 67 20L76 28" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M27 47V84C27 91 32 95 39 95H43C49 95 53 91 53 84V76" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M44 59L59 45L71 55L98 27" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M83 25H100V42" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M55 95H90C96 95 100 91 100 84V47L93 40" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M67 95V68" stroke="#138A59" stroke-width="10" stroke-linecap="round"/>
                                <path d="M83 95V58" stroke="#138A59" stroke-width="10" stroke-linecap="round"/>
                                <path d="M100 47L107 54" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="flex flex-col leading-none">
                            <span class="font-display font-extrabold text-2xl text-white">financie</span>
                            <span class="font-display font-extrabold text-2xl text-brand-greenLight -mt-1">suaobra<span class="text-xs font-normal text-slate-300 ml-1">.com.br</span></span>
                        </div>
                    </div>
