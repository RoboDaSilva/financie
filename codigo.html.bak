    <!-- FLOATING WHATSAPP BUTTON -->
    <a href="#" id="floatingWhatsappBtn" target="_blank" rel="noopener noreferrer" aria-label="Conversar no WhatsApp" class="fixed bottom-6 right-6 z-40 w-14 h-14 rounded-full bg-brand-green hover:bg-brand-greenDark text-white flex items-center justify-center text-3xl shadow-2xl whatsapp-pulse transition transform hover:scale-110">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- APPLICATION LOGIC & STATE MANAGEMENT -->
    <script>
        // ============================================================================
        // 1. INITIAL DATA (SITE SETTINGS, OFFICIAL FAVICON & DEFAULT PORTFOLIO PROJECTS)
        // ============================================================================
        function getOfficialLogoFaviconDataUrl() {
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 110">
                <rect width="120" height="110" rx="24" fill="#FFFFFF"/>
                <path d="M16 55L56 20C59.5 17 63.5 17 67 20L76 28" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M27 47V84C27 91 32 95 39 95H43C49 95 53 91 53 84V76" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M44 59L59 45L71 55L98 27" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M83 25H100V42" stroke="#0F3156" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M55 95H90C96 95 100 91 100 84V47L93 40" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M67 95V68" stroke="#138A59" stroke-width="10" stroke-linecap="round" fill="none"/>
                <path d="M83 95V58" stroke="#138A59" stroke-width="10" stroke-linecap="round" fill="none"/>
                <path d="M100 47L107 54" stroke="#138A59" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>`;
            return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
        }

        const defaultSiteConfig = {
            whatsapp: "5544999999999",
            phoneDisplay: "(44) 99999-9999",
            whatsappMsg: "Olá! Vim pelo site financiesuaobra.com.br e gostaria de conversar sobre construção financiada pela Caixa (Grupo Geminadas.com & Level Construtora).",
            instagram: "https://instagram.com/geminadas",
            facebook: "https://facebook.com/geminadas",
            youtube: "https://youtube.com/@geminadas",
            interestRate: 9.89,
            address: "Grupo Geminadas.com Arquitetura & Level Construtora - Atendimento Presencial e Online",
            email: "contato@financiesuaobra.com.br",
            heroTitle: "Construa sua Casa de Médio ou Alto Padrão com Recursos da Caixa.",
            pageTitle: "financiesuaobra.com.br | Construção Financiada Caixa - Grupo Geminadas.com & Level",
            faviconUrl: getOfficialLogoFaviconDataUrl()
        };

        let siteConfig = { ...defaultSiteConfig };

        // Helper function to generate clean SVG architectural floorplan data URLs for default projects
        function createArchitecturalFloorplanSvg(title, area, specs) {
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 550" width="100%" height="100%">
                <rect width="800" height="550" fill="#0F3156"/>
                <g stroke="#1A4B82" stroke-width="1">
                    <line x1="0" y1="50" x2="800" y2="50"/><line x1="0" y1="100" x2="800" y2="100"/><line x1="0" y1="150" x2="800" y2="150"/>
                    <line x1="0" y1="200" x2="800" y2="200"/><line x1="0" y1="250" x2="800" y2="250"/><line x1="0" y1="300" x2="800" y2="300"/>
                    <line x1="0" y1="350" x2="800" y2="350"/><line x1="0" y1="400" x2="800" y2="400"/><line x1="0" y1="450" x2="800" y2="450"/>
                    <line x1="100" y1="0" x2="100" y2="550"/><line x1="200" y1="0" x2="200" y2="550"/><line x1="300" y1="0" x2="300" y2="550"/>
                    <line x1="400" y1="0" x2="400" y2="550"/><line x1="500" y1="0" x2="500" y2="550"/><line x1="600" y1="0" x2="600" y2="550"/><line x1="700" y1="0" x2="700" y2="550"/>
                </g>
                <!-- Outer Walls -->
                <rect x="90" y="60" width="620" height="390" fill="#091E36" stroke="#FFFFFF" stroke-width="6"/>
                <!-- Internal Rooms -->
                <rect x="90" y="60" width="220" height="170" fill="none" stroke="#138A59" stroke-width="4"/>
                <text x="200" y="140" fill="#FFFFFF" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">SUÍTE MASTER + CLOSET</text>
                <text x="200" y="162" fill="#34D399" font-family="sans-serif" font-size="12" text-anchor="middle">28,50 m²</text>

                <rect x="310" y="60" width="180" height="170" fill="none" stroke="#FFFFFF" stroke-width="3"/>
                <text x="400" y="140" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">SUÍTE 02</text>
                <text x="400" y="160" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">16,20 m²</text>

                <rect x="490" y="60" width="220" height="170" fill="#0F3156" stroke="#38BDF8" stroke-width="3"/>
                <text x="600" y="140" fill="#38BDF8" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">PISCINA &amp; DECK</text>
                <text x="600" y="160" fill="#E2E8F0" font-family="sans-serif" font-size="12" text-anchor="middle">Lazer Integrado</text>

                <rect x="90" y="230" width="220" height="220" fill="none" stroke="#FFFFFF" stroke-width="3"/>
                <text x="200" y="335" fill="#FFFFFF" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">GARAGEM LADO A LADO</text>
                <text x="200" y="355" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">2 Carros Cobertos</text>

                <rect x="310" y="230" width="400" height="220" fill="none" stroke="#138A59" stroke-width="4"/>
                <text x="510" y="330" fill="#FFFFFF" font-family="sans-serif" font-size="17" font-weight="bold" text-anchor="middle">LIVING + COZINHA GOURMET INTEGRADA</text>
                <text x="510" y="355" fill="#34D399" font-family="sans-serif" font-size="13" text-anchor="middle">Pé-Direito Duplo • 54,00 m²</text>

                <!-- Blueprint Title Block -->
                <rect x="90" y="470" width="620" height="50" rx="8" fill="#138A59"/>
                <text x="115" y="500" fill="#FFFFFF" font-family="sans-serif" font-size="15" font-weight="bold">PLANTA BAIXA: ${title.toUpperCase()} (${area}m²)</text>
                <text x="690" y="500" fill="#E2E8F0" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="end">ARQUITETURA: GEMINADAS.COM</text>
            </svg>`;
            return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
        }

        let projects = [
            {
                id: "obra-1",
                title: "Residência Horizonte Contemporânea",
                modality: "Terreno + Construção",
                standard: "Alto Padrão",
                location: "Condomínio Fechado • Maringá/PR",
                timeline: "11 meses",
                area: 235,
                lotArea: 420,
                beds: "3 Suítes (1 Master)",
                garage: 2,
                cost: 920000,
                valuation: 1280000,
                photoUrl: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1000&q=80",
                floorplanUrl: createArchitecturalFloorplanSvg("Residência Horizonte", 235, "3 Suítes"),
                description: "Obra executada 100% via financiamento Caixa na modalidade Aquisição de Terreno + Construção. Projeto arquitetônico assinado pela Geminadas.com com fachada em concreto aparente, brises amadeirados, pé-direito duplo no living integrado ao espaço gourmet e piscina com prainha. Execução rigorosa pela Level Construtora."
            },
            {
                id: "obra-2",
                title: "Casa Reserva Imperial",
                modality: "Construção em Terreno Próprio",
                standard: "Alto Padrão",
                location: "Condomínio Jardins • Região Metropolitana",
                timeline: "10 meses",
                area: 192,
                lotArea: 360,
                beds: "3 Suítes",
                garage: 2,
                cost: 740000,
                valuation: 1020000,
                photoUrl: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80",
                floorplanUrl: createArchitecturalFloorplanSvg("Casa Reserva Imperial", 192, "3 Suítes"),
                description: "O cliente já possuía o terreno quitado no condomínio e utilizou o próprio lote como entrada na operação junto à Caixa Econômica Federal. Planta baixa inteligente otimizando a insolação da tarde na piscina, esquadrias automatizadas em PVC preto e porcelanatos de grandes formatos."
            },
            {
                id: "obra-3",
                title: "Residência Bella Vista",
                modality: "Terreno + Construção",
                standard: "Médio Padrão",
                location: "Bairro Planejado • Alto da Boa Vista",
                timeline: "8 meses",
                area: 148,
                lotArea: 300,
                beds: "1 Suíte + 2 Demi",
                garage: 2,
                cost: 530000,
                valuation: 720000,
                photoUrl: "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1000&q=80",
                floorplanUrl: createArchitecturalFloorplanSvg("Residência Bella Vista", 148, "1 Suíte + 2 Quartos"),
                description: "Projeto focado em altíssima liquidez e conforto familiar. Compra do terreno e construção financiadas em contrato único pela Caixa com uso do FGTS na entrada. Entregue pela Level Construtora com área gourmet com churrasqueira a carvão, lavabo e infraestrutura completa para energia solar e ar-condicionado."
            }
        ];

        // Simulator State
        let simState = {
            modality: 'terreno_construcao', // 'terreno_construcao' or 'terreno_proprio'
            standard: 'alto',               // 'medio', 'alto', 'luxo'
            costPerSqm: 3550
        };

        let currentFilter = 'all';
        let activeModalProject = null;

        // ============================================================================
        // 2. CURRENCY & UI HELPERS
        // ============================================================================
        function formatBRL(value) {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 }).format(value);
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-brand-green' : 'bg-brand-blue';
            toast.className = `${bgClass} text-white px-5 py-3.5 rounded-2xl shadow-xl flex items-center gap-3 text-sm font-semibold pointer-events-auto transition transform duration-300`;
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-lg"></i> <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-x-5');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const icon = document.getElementById('mobileMenuIcon');
            menu.classList.toggle('hidden');
            icon.className = menu.classList.contains('hidden') ? 'fa-solid fa-bars text-xl' : 'fa-solid fa-xmark text-xl';
        }

        function toggleView(view) {
            const publicView = document.getElementById('publicView');
            const adminView = document.getElementById('adminView');
            const publicNav = document.getElementById('publicNav');
            const adminBtnLabel = document.getElementById('adminBtnLabel');

            if (view === 'admin') {
                publicView.classList.add('hidden');
                adminView.classList.remove('hidden');
                publicNav.classList.add('hidden');
                adminBtnLabel.textContent = 'Ver Site Público';
                document.getElementById('adminToggleBtnTop').setAttribute('onclick', "toggleView('public')");
                populateAdminConfigForm();
                renderAdminProjectsList();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                adminView.classList.add('hidden');
                publicView.classList.remove('hidden');
                publicNav.classList.remove('hidden');
                adminBtnLabel.textContent = 'Painel Admin';
                document.getElementById('adminToggleBtnTop').setAttribute('onclick', "toggleView('admin')");
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // ============================================================================
        // 3. APPLY SITE CONFIG (WHATSAPP, SOCIAL MEDIA, FAVICON) & LOCALSTORAGE
        // ============================================================================
        function loadSavedDataFromStorage() {
            try {
                const savedCfg = localStorage.getItem('fso_siteConfig_v2');
                if (savedCfg) {
                    siteConfig = { ...defaultSiteConfig, ...JSON.parse(savedCfg) };
                }
                const savedProjs = localStorage.getItem('fso_projects_v2');
                if (savedProjs) {
                    const parsed = JSON.parse(savedProjs);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        projects = parsed;
                    }
                }
            } catch (err) {
                console.warn('Erro ao carregar dados salvos:', err);
            }
        }

        function persistDataToStorage() {
            try {
                localStorage.setItem('fso_siteConfig_v2', JSON.stringify(siteConfig));
                localStorage.setItem('fso_projects_v2', JSON.stringify(projects));
            } catch (err) {
                console.warn('Limite de armazenamento atingido:', err);
            }
        }

        function applySiteConfigToUI() {
            const cleanWa = (siteConfig.whatsapp || "5544999999999").replace(/\D/g, '');
            const customMsg = siteConfig.whatsappMsg || defaultSiteConfig.whatsappMsg;
            const defaultWaMsg = encodeURIComponent(customMsg);
            const waUrl = `https://wa.me/${cleanWa}?text=${defaultWaMsg}`;

            // Update all WhatsApp buttons
            document.getElementById('headerWhatsappBtn').href = waUrl;
            document.getElementById('mobileWhatsappBtn').href = waUrl;
            document.getElementById('floatingWhatsappBtn').href = waUrl;
            const heroWaBtn = document.getElementById('heroWhatsappBtn');
            if (heroWaBtn) {
                heroWaBtn.href = waUrl;
                document.getElementById('heroWhatsappLabel').textContent = siteConfig.phoneDisplay ? `WhatsApp: ${siteConfig.phoneDisplay}` : 'Falar no WhatsApp';
            }

            // Update Favicon and Browser Tab Title dynamically
            const activeFavicon = siteConfig.faviconUrl || getOfficialLogoFaviconDataUrl();
            const faviconLink = document.getElementById('dynamicFavicon');
            if (faviconLink) faviconLink.href = activeFavicon;
            document.title = siteConfig.pageTitle || defaultSiteConfig.pageTitle;

            // Update Footer & Texts
            document.getElementById('footerPhone').textContent = siteConfig.phoneDisplay || siteConfig.whatsapp;
            document.getElementById('footerEmail').textContent = siteConfig.email;
            document.getElementById('footerAddress').textContent = siteConfig.address;
            document.getElementById('resRateDisplay').textContent = `${siteConfig.interestRate.toString().replace('.', ',')}%`;

            // Render Social Icons in Topbar, Hero Quick-Connect Bar & Footer
            const topSocial = document.getElementById('topSocialLinks');
            const heroSocial = document.getElementById('heroSocialBadges');
            const footerSocial = document.getElementById('footerSocialLinks');
            let topHtml = '';
            let heroHtml = '';
            let footerHtml = '';

            // Always show WhatsApp direct link in Topbar and Footer social bars
            topHtml += `<a href="${waUrl}" target="_blank" rel="noopener noreferrer" title="WhatsApp ${siteConfig.phoneDisplay}" class="text-emerald-300 hover:text-white transition flex items-center gap-1 font-semibold"><i class="fa-brands fa-whatsapp text-sm"></i> <span class="hidden md:inline">${siteConfig.phoneDisplay}</span></a>`;
            footerHtml += `<a href="${waUrl}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-10 h-10 rounded-xl bg-brand-green hover:bg-brand-greenLight flex items-center justify-center text-white transition"><i class="fa-brands fa-whatsapp text-lg"></i></a>`;

            if (siteConfig.instagram) {
                topHtml += `<a href="${siteConfig.instagram}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white/80 hover:text-brand-greenLight transition"><i class="fa-brands fa-instagram text-sm"></i></a>`;
                heroHtml += `<a href="${siteConfig.instagram}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/15 px-3 py-1.5 rounded-xl text-xs font-semibold text-white transition"><i class="fa-brands fa-instagram text-pink-400 text-sm"></i> Instagram</a>`;
                footerHtml += `<a href="${siteConfig.instagram}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-brand-green flex items-center justify-center text-white transition"><i class="fa-brands fa-instagram text-lg"></i></a>`;
            }
            if (siteConfig.facebook) {
                topHtml += `<a href="${siteConfig.facebook}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-white/80 hover:text-brand-greenLight transition"><i class="fa-brands fa-facebook text-sm"></i></a>`;
                heroHtml += `<a href="${siteConfig.facebook}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/15 px-3 py-1.5 rounded-xl text-xs font-semibold text-white transition"><i class="fa-brands fa-facebook text-blue-400 text-sm"></i> Facebook</a>`;
                footerHtml += `<a href="${siteConfig.facebook}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-brand-green flex items-center justify-center text-white transition"><i class="fa-brands fa-facebook text-lg"></i></a>`;
            }
            if (siteConfig.youtube) {
                topHtml += `<a href="${siteConfig.youtube}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-white/80 hover:text-brand-greenLight transition"><i class="fa-brands fa-youtube text-sm"></i></a>`;
                heroHtml += `<a href="${siteConfig.youtube}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/15 px-3 py-1.5 rounded-xl text-xs font-semibold text-white transition"><i class="fa-brands fa-youtube text-red-400 text-sm"></i> YouTube</a>`;
                footerHtml += `<a href="${siteConfig.youtube}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-brand-green flex items-center justify-center text-white transition"><i class="fa-brands fa-youtube text-lg"></i></a>`;
            }

            topSocial.innerHTML = topHtml;
            if (heroSocial) heroSocial.innerHTML = heroHtml;
            footerSocial.innerHTML = footerHtml;

            updateSimulation();
        }

        function populateAdminConfigForm() {
            document.getElementById('cfgWhatsapp').value = siteConfig.whatsapp || '';
            document.getElementById('cfgPhoneDisplay').value = siteConfig.phoneDisplay || '';
            document.getElementById('cfgWhatsappMsg').value = siteConfig.whatsappMsg || '';
            document.getElementById('cfgInstagram').value = siteConfig.instagram || '';
            document.getElementById('cfgFacebook').value = siteConfig.facebook || '';
            document.getElementById('cfgYoutube').value = siteConfig.youtube || '';
            document.getElementById('cfgInterestRate').value = siteConfig.interestRate || 9.89;
            document.getElementById('cfgAddress').value = siteConfig.address || '';
            document.getElementById('cfgEmail').value = siteConfig.email || '';
            document.getElementById('cfgHeroTitle').value = siteConfig.heroTitle || '';
            document.getElementById('cfgPageTitle').value = siteConfig.pageTitle || defaultSiteConfig.pageTitle;
            document.getElementById('cfgFaviconUrl').value = siteConfig.faviconUrl || getOfficialLogoFaviconDataUrl();
            updateLiveAdminPreview();
        }

        function updateLiveAdminPreview() {
            const favInput = document.getElementById('cfgFaviconUrl').value.trim() || getOfficialLogoFaviconDataUrl();
            const titleInput = document.getElementById('cfgPageTitle').value.trim() || defaultSiteConfig.pageTitle;
            const previewImg = document.getElementById('browserTabFaviconPreview');
            const previewTitle = document.getElementById('browserTabTitlePreview');

            if (previewImg) previewImg.src = favInput;
            if (previewTitle) previewTitle.textContent = titleInput;
        }

        function useOfficialLogoFavicon() {
            const officialSvg = getOfficialLogoFaviconDataUrl();
            document.getElementById('cfgFaviconUrl').value = officialSvg;
            siteConfig.faviconUrl = officialSvg;
            updateLiveAdminPreview();
            applySiteConfigToUI();
            persistDataToStorage();
            showToast('Ícone oficial da logo (Casa + Gráfico) aplicado na aba do navegador!');
        }

        function handleFaviconUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    canvas.width = 64;
                    canvas.height = 64;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, 64, 64);
                    const faviconDataUrl = canvas.toDataURL('image/png');
                    document.getElementById('cfgFaviconUrl').value = faviconDataUrl;
                    siteConfig.faviconUrl = faviconDataUrl;
                    updateLiveAdminPreview();
                    applySiteConfigToUI();
                    persistDataToStorage();
                    showToast('Novo ícone da aba do site carregado e aplicado!');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function saveSiteConfig(e) {
            e.preventDefault();
            siteConfig.whatsapp = document.getElementById('cfgWhatsapp').value.trim();
            siteConfig.phoneDisplay = document.getElementById('cfgPhoneDisplay').value.trim();
            siteConfig.whatsappMsg = document.getElementById('cfgWhatsappMsg').value.trim();
            siteConfig.instagram = document.getElementById('cfgInstagram').value.trim();
            siteConfig.facebook = document.getElementById('cfgFacebook').value.trim();
            siteConfig.youtube = document.getElementById('cfgYoutube').value.trim();
            siteConfig.interestRate = parseFloat(document.getElementById('cfgInterestRate').value) || 9.89;
            siteConfig.address = document.getElementById('cfgAddress').value.trim();
            siteConfig.email = document.getElementById('cfgEmail').value.trim();
            siteConfig.heroTitle = document.getElementById('cfgHeroTitle').value.trim();
            siteConfig.pageTitle = document.getElementById('cfgPageTitle').value.trim() || defaultSiteConfig.pageTitle;
            siteConfig.faviconUrl = document.getElementById('cfgFaviconUrl').value.trim() || getOfficialLogoFaviconDataUrl();

            if (siteConfig.heroTitle) {
                document.getElementById('heroHeadline').innerHTML = siteConfig.heroTitle;
            }

            persistDataToStorage();
            applySiteConfigToUI();
            showToast('WhatsApp, Redes Sociais e Ícone da Aba atualizados com sucesso!');
        }

        function exportBackupJson() {
            const data = { siteConfig, projects, exportedAt: new Date().toISOString() };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'backup-financiesuaobra.json';
            a.click();
            URL.revokeObjectURL(url);
            showToast('Backup exportado com sucesso!');
        }

        function importBackupJson(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.siteConfig) siteConfig = { ...defaultSiteConfig, ...imported.siteConfig };
                    if (Array.isArray(imported.projects)) projects = imported.projects;
                    persistDataToStorage();
                    populateAdminConfigForm();
                    applySiteConfigToUI();
                    renderPublicProjects();
                    renderAdminProjectsList();
                    showToast('Backup importado e restaurado com sucesso!');
                } catch (err) {
                    showToast('Arquivo de backup inválido.', 'error');
                }
            };
            reader.readAsText(file);
        }

        // ============================================================================
        // 4. CAIXA CREDIT SIMULATOR ENGINE
        // ============================================================================
        function selectModalityInSimulator(mod) {
            setSimModality(mod);
        }

        function setSimModality(mod) {
            simState.modality = mod;
            const btnTC = document.getElementById('btnModTerrenoObra');
            const btnTP = document.getElementById('btnModTerrenoProprio');
            const labelTerreno = document.getElementById('labelTerreno');

            if (mod === 'terreno_construcao') {
                btnTC.className = "p-4 rounded-2xl border-2 border-brand-green bg-emerald-50/50 text-left transition flex items-center gap-3";
                btnTP.className = "p-4 rounded-2xl border-2 border-slate-200 hover:border-brand-blue text-left transition flex items-center gap-3";
                labelTerreno.textContent = "Valor do Terreno a Adquirir:";
            } else {
                btnTP.className = "p-4 rounded-2xl border-2 border-brand-green bg-emerald-50/50 text-left transition flex items-center gap-3";
                btnTC.className = "p-4 rounded-2xl border-2 border-slate-200 hover:border-brand-blue text-left transition flex items-center gap-3";
                labelTerreno.textContent = "Valor de Avaliação do Seu Terreno Próprio:";
            }
            updateSimulation();
        }

        function setSimStandard(std) {
            simState.standard = std;
            const mapCost = { medio: 3100, alto: 3650, luxo: 4600 };
            simState.costPerSqm = mapCost[std] || 3650;

            ['Medio', 'Alto', 'Luxo'].forEach(item => {
                const el = document.getElementById('std' + item);
                if (item.toLowerCase() === std) {
                    el.className = "py-2.5 px-3 rounded-xl border-2 border-brand-blue bg-brand-blue text-white text-xs sm:text-sm font-bold transition";
                } else {
                    el.className = "py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:border-brand-blue transition";
                }
            });
            updateSimulation();
        }

        function updateSimulation(changedSource) {
            const SFH_MAX_LIMIT = 2250000;
            const terrenoInput = document.getElementById('simTerrenoRange');
            const obraInput = document.getElementById('simObraRange');
            const sfhBadge = document.getElementById('sfhLimitBadge');

            let terrenoVal = parseFloat(terrenoInput.value) || 0;
            let obraVal = parseFloat(obraInput.value) || 0;

            // Enforce SFH Ceiling of R$ 2.250.000 for combined Investment (Terreno + Obra)
            if (terrenoVal + obraVal > SFH_MAX_LIMIT) {
                if (changedSource === 'terreno') {
                    obraVal = Math.max(200000, SFH_MAX_LIMIT - terrenoVal);
                    if (terrenoVal + obraVal > SFH_MAX_LIMIT) {
                        terrenoVal = SFH_MAX_LIMIT - obraVal;
                        terrenoInput.value = terrenoVal;
                    }
                    obraInput.value = obraVal;
                } else {
                    terrenoVal = Math.max(80000, SFH_MAX_LIMIT - obraVal);
                    if (terrenoVal + obraVal > SFH_MAX_LIMIT) {
                        obraVal = SFH_MAX_LIMIT - terrenoVal;
                        obraInput.value = obraVal;
                    }
                    terrenoInput.value = terrenoVal;
                }
            }

            const totalGlobal = terrenoVal + obraVal;
            if (sfhBadge) {
                if (totalGlobal >= SFH_MAX_LIMIT) {
                    sfhBadge.classList.remove('hidden');
                } else {
                    sfhBadge.classList.add('hidden');
                }
            }

            let entradaVal = parseFloat(document.getElementById('simEntradaRange').value) || 0;
            const months = parseInt(document.getElementById('simPrazoSelect').value) || 420;

            const minEntryRequired = totalGlobal * 0.20; // Caixa 80% max financing quota

            // In "Terreno Próprio", the land value counts toward the client's equity/entry
            let effectiveCashEntry = entradaVal;
            let financedAmount = 0;

            if (simState.modality === 'terreno_construcao') {
                if (effectiveCashEntry < minEntryRequired) {
                    effectiveCashEntry = minEntryRequired;
                    document.getElementById('simEntradaRange').value = effectiveCashEntry;
                }
                if (effectiveCashEntry > totalGlobal * 0.9) {
                    effectiveCashEntry = totalGlobal * 0.9;
                }
                financedAmount = Math.max(0, totalGlobal - effectiveCashEntry);
                document.getElementById('resEntrySummary').textContent = `Entrada + FGTS: ${formatBRL(effectiveCashEntry)} (${Math.round((effectiveCashEntry/totalGlobal)*100)}% do total)`;
            } else {
                // Terreno próprio: Caixa finances up to 80% of global evaluation, capped at 100% of construction cost
                const maxCaixaQuota = totalGlobal * 0.80;
                const desiredFinance = Math.max(0, obraVal - effectiveCashEntry);
                financedAmount = Math.min(maxCaixaQuota, desiredFinance);
                const actualCashNeeded = Math.max(0, obraVal - financedAmount);
                document.getElementById('resEntrySummary').textContent = `Terreno próprio entra na operação! Recurso extra/FGTS: ${formatBRL(actualCashNeeded)}`;
            }

            // Update Displays
            document.getElementById('simTerrenoDisplay').textContent = formatBRL(terrenoVal);
            document.getElementById('simObraDisplay').textContent = formatBRL(obraVal);
            document.getElementById('simEntradaDisplay').textContent = formatBRL(effectiveCashEntry);

            const approxSqm = Math.round(obraVal / simState.costPerSqm);
            document.getElementById('simAreaEstimada').textContent = `Área construída estimada: ~${approxSqm} m²`;

            // SAC Amortization Calculation
            const annualRate = (siteConfig.interestRate || 9.89) / 100;
            const monthlyRate = Math.pow(1 + annualRate, 1 / 12) - 1;
            const monthlyAmortization = financedAmount / months;
            const adminInsuranceFee = 65; // Standard monthly MIP/DFI + Caixa operational estimate

            const firstInstallment = financedAmount > 0 ? (monthlyAmortization + (financedAmount * monthlyRate) + adminInsuranceFee) : 0;
            const lastInstallment = financedAmount > 0 ? (monthlyAmortization + (monthlyAmortization * monthlyRate) + adminInsuranceFee) : 0;
            const requiredIncome = firstInstallment / 0.30; // 30% income commitment rule

            // Market Valuation (+28% immediate appreciation upon Habite-se)
            const marketValuation = totalGlobal * 1.28;
            const equityGain = marketValuation - totalGlobal;

            document.getElementById('resTotalProject').textContent = formatBRL(totalGlobal);
            document.getElementById('resFinancedAmount').textContent = formatBRL(financedAmount);
            document.getElementById('resFirstInstallment').textContent = formatBRL(firstInstallment);
            document.getElementById('resLastInstallment').textContent = formatBRL(lastInstallment);
            document.getElementById('resRequiredIncome').textContent = `${formatBRL(requiredIncome)}/mês`;
            document.getElementById('resMarketValuation').textContent = formatBRL(marketValuation);
            document.getElementById('resNetEquityGain').innerHTML = `Ganho patrimonial estimado na entrega: <strong>+ ${formatBRL(equityGain)}</strong>`;
        }

        function sendSimulationToWhatsApp() {
            const clientName = document.getElementById('simClientName').value.trim();
            const terrenoVal = parseFloat(document.getElementById('simTerrenoRange').value) || 0;
            const obraVal = parseFloat(document.getElementById('simObraRange').value) || 0;
            const months = document.getElementById('simPrazoSelect').value;
            const financedText = document.getElementById('resFinancedAmount').textContent;
            const firstInstText = document.getElementById('resFirstInstallment').textContent;
            const modLabel = simState.modality === 'terreno_construcao' ? 'Aquisição de Terreno + Construção' : 'Construção em Terreno Próprio';
            const stdLabel = simState.standard === 'medio' ? 'Médio Padrão' : (simState.standard === 'alto' ? 'Alto Padrão' : 'Alto Luxo');

            const greeting = clientName ? `Olá! Meu nome é *${clientName}*.` : `Olá!`;
            const message = `${greeting} Fiz uma simulação no site *financiesuaobra.com.br* e gostaria de receber um estudo personalizado:\n\n` +
                `▪ *Modalidade:* ${modLabel}\n` +
                `▪ *Padrão:* ${stdLabel} (Geminadas.com & Level)\n` +
                `▪ *Valor do Terreno:* ${formatBRL(terrenoVal)}\n` +
                `▪ *Orçamento da Obra:* ${formatBRL(obraVal)}\n` +
                `▪ *Valor Financiado Caixa:* ${financedText}\n` +
                `▪ *Prazo:* ${months} meses | *1ª Parcela Est.:* ${firstInstText}\n\n` +
                `Podemos agendar uma conversa?`;

            const cleanWa = siteConfig.whatsapp.replace(/\D/g, '');
            window.open(`https://wa.me/${cleanWa}?text=${encodeURIComponent(message)}`, '_blank');
        }

        // ============================================================================
        // 5. PORTFOLIO GALLERY, FILTER & MODAL (PHOTOS + FLOORPLAN)
        // ============================================================================
        function filterProjects(filterValue) {
            currentFilter = filterValue;
            const btnAll = document.getElementById('filter-all');
            const btnTc = document.getElementById('filter-tc');
            const btnTp = document.getElementById('filter-tp');

            [btnAll, btnTc, btnTp].forEach(b => {
                b.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-brand-ice text-slate-700 hover:bg-slate-200 transition";
            });

            if (filterValue === 'all') btnAll.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition";
            if (filterValue === 'Terreno + Construção') btnTc.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition";
            if (filterValue === 'Construção em Terreno Próprio') btnTp.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition";

            renderPublicProjects();
        }

        function renderPublicProjects() {
            const grid = document.getElementById('projectsGrid');
            const filtered = currentFilter === 'all'
                ? projects
                : projects.filter(p => p.modality === currentFilter);

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 bg-brand-ice rounded-3xl text-slate-500">Nenhuma obra encontrada neste filtro. Cadastre novas obras na aba Admin!</div>`;
                return;
            }

            grid.innerHTML = filtered.map(proj => {
                const gainPercent = proj.valuation && proj.cost ? Math.round(((proj.valuation - proj.cost) / proj.cost) * 100) : 28;
                return `
                <article class="bg-white rounded-3xl overflow-hidden shadow-lg border border-slate-100 hover:shadow-2xl transition flex flex-col justify-between group">
                    <div>
                        <div class="relative h-60 overflow-hidden bg-slate-200 cursor-pointer" onclick="openProjectModal('${proj.id}')">
                            <img src="${proj.photoUrl}" alt="${proj.title}" onerror="this.src='https://placehold.co/800x500/0F3156/FFFFFF?text=Obra+Financiada'" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <div class="absolute top-3 left-3 bg-brand-blue/90 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full">
                                ${proj.modality}
                            </div>
                            <div class="absolute top-3 right-3 bg-brand-green text-white text-[11px] font-bold px-3 py-1 rounded-full shadow">
                                ${proj.standard}
                            </div>
                            <div class="absolute bottom-3 right-3 bg-white/95 text-brand-blue text-xs font-bold px-3 py-1.5 rounded-xl shadow flex items-center gap-1.5">
                                <i class="fa-solid fa-compass-drafting text-brand-green"></i> Fotos + Planta Baixa
                            </div>
                        </div>

                        <div class="p-6">
                            <div class="text-xs font-semibold text-slate-400 flex items-center gap-1.5 mb-1">
                                <i class="fa-solid fa-location-dot text-brand-green"></i> ${proj.location}
                            </div>
                            <h3 class="font-display font-extrabold text-xl text-brand-blue group-hover:text-brand-green transition cursor-pointer" onclick="openProjectModal('${proj.id}')">
                                ${proj.title}
                            </h3>

                            <div class="grid grid-cols-3 gap-2 my-4 py-3 border-y border-slate-100 text-xs text-slate-600">
                                <div class="flex items-center gap-1.5">
                                    <i class="fa-solid fa-ruler-combined text-brand-blue"></i>
                                    <span><strong>${proj.area}</strong> m²</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <i class="fa-solid fa-bed text-brand-blue"></i>
                                    <span class="truncate">${proj.beds}</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <i class="fa-solid fa-car text-brand-blue"></i>
                                    <span><strong>${proj.garage || 2}</strong> Vagas</span>
                                </div>
                            </div>

                            <div class="flex items-center justify-between bg-brand-ice px-4 py-2.5 rounded-xl">
                                <div>
                                    <span class="block text-[10px] uppercase font-bold text-slate-400">Investimento / Caixa</span>
                                    <span class="font-display font-extrabold text-sm text-brand-blue">${formatBRL(proj.cost)}</span>
                                </div>
                                <div class="text-right">
                                    <span class="block text-[10px] uppercase font-bold text-brand-green">Valorização (+${gainPercent}%)</span>
                                    <span class="font-display font-bold text-xs text-slate-700">Aval.: ${formatBRL(proj.valuation || proj.cost * 1.28)}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 pb-6 pt-1 flex gap-2">
                        <button onclick="openProjectModal('${proj.id}', 'photo')" class="flex-1 py-2.5 px-3 rounded-xl bg-brand-blue hover:bg-brand-blueLight text-white font-bold text-xs transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-eye"></i> Detalhes da Obra
                        </button>
                        <button onclick="openProjectModal('${proj.id}', 'floorplan')" class="py-2.5 px-3.5 rounded-xl bg-emerald-50 hover:bg-brand-green text-brand-greenDark hover:text-white border border-brand-green/30 font-bold text-xs transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-compass-drafting"></i> Planta Baixa
                        </button>
                    </div>
                </article>`;
            }).join('');
        }

        function openProjectModal(projectId, initialTab = 'photo') {
            const proj = projects.find(p => p.id === projectId);
            if (!proj) return;
            activeModalProject = proj;

            document.getElementById('modalBadge').textContent = `${proj.modality} • ${proj.standard}`;
            document.getElementById('modalTitle').textContent = proj.title;
            document.getElementById('modalLocation').innerHTML = `<i class="fa-solid fa-location-dot text-brand-green"></i> ${proj.location}`;
            document.getElementById('modalArea').textContent = `${proj.area} m²`;
            document.getElementById('modalLot').textContent = `${proj.lotArea || 360} m²`;
            document.getElementById('modalBeds').textContent = proj.beds;
            document.getElementById('modalTimeline').textContent = proj.timeline || '10 meses';
            document.getElementById('modalCost').textContent = formatBRL(proj.cost);
            document.getElementById('modalValuation').textContent = formatBRL(proj.valuation || proj.cost * 1.28);
            document.getElementById('modalDescription').textContent = proj.description;

            switchModalMedia(initialTab);

            const cleanWa = siteConfig.whatsapp.replace(/\D/g, '');
            const msg = `Olá! Vi a obra *${proj.title}* (${proj.area}m² - ${proj.modality}) no site *financiesuaobra.com.br* e gostaria de orçar um projeto similar com financiamento Caixa.`;
            document.getElementById('modalWhatsappBtn').onclick = () => {
                window.open(`https://wa.me/${cleanWa}?text=${encodeURIComponent(msg)}`, '_blank');
            };

            document.getElementById('projectModal').classList.remove('hidden');
        }

        function switchModalMedia(type) {
            if (!activeModalProject) return;
            const img = document.getElementById('modalMainImage');
            const caption = document.getElementById('modalMediaCaption');
            const btnPhoto = document.getElementById('modalBtnPhoto');
            const btnFloorplan = document.getElementById('modalBtnFloorplan');

            if (type === 'floorplan') {
                img.src = activeModalProject.floorplanUrl || createArchitecturalFloorplanSvg(activeModalProject.title, activeModalProject.area, activeModalProject.beds);
                caption.textContent = "Planta Baixa Inteligente • Escritório Geminadas.com Arquitetura";
                btnFloorplan.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-green text-white transition flex items-center gap-2";
                btnPhoto.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-brand-blue border border-slate-200 transition flex items-center gap-2";
            } else {
                img.src = activeModalProject.photoUrl;
                caption.textContent = "Obra Executada pela Level Construtora • Financiamento Caixa";
                btnPhoto.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-blue text-white transition flex items-center gap-2";
                btnFloorplan.className = "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-brand-blue border border-slate-200 hover:border-brand-green transition flex items-center gap-2";
            }
        }

        function closeProjectModal() {
            document.getElementById('projectModal').classList.add('hidden');
        }

        // ============================================================================
        // 6. ADMIN CMS: CREATE, EDIT, DELETE PROJECTS & IMAGE COMPRESSION
        // ============================================================================
        function handleImageUpload(event, targetInputId, previewImgId) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    // Compress image via Canvas to keep site fast and lightweight
                    const canvas = document.createElement('canvas');
                    const maxWidth = 1000;
                    const scale = img.width > maxWidth ? maxWidth / img.width : 1;
                    canvas.width = img.width * scale;
                    canvas.height = img.height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.82);

                    document.getElementById(targetInputId).value = compressedDataUrl;
                    const preview = document.getElementById(previewImgId);
                    preview.src = compressedDataUrl;
                    preview.classList.remove('hidden');
                    showToast('Imagem carregada e otimizada com sucesso!');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function saveProject(e) {
            e.preventDefault();
            const existingId = document.getElementById('projId').value;
            const title = document.getElementById('projTitle').value.trim();
            const area = parseInt(document.getElementById('projArea').value) || 180;
            const beds = document.getElementById('projBeds').value.trim() || "3 Suítes";
            const cost = parseFloat(document.getElementById('projCost').value) || 650000;
            const valuation = parseFloat(document.getElementById('projValuation').value) || Math.round(cost * 1.28);

            const photoUrl = document.getElementById('projPhotoUrl').value.trim() || "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80";
            const floorplanUrl = document.getElementById('projFloorplanUrl').value.trim() || createArchitecturalFloorplanSvg(title, area, beds);

            const projectData = {
                id: existingId || 'obra-' + Date.now(),
                title,
                modality: document.getElementById('projModality').value,
                standard: document.getElementById('projStandard').value,
                location: document.getElementById('projLocation').value.trim(),
                timeline: document.getElementById('projTimeline').value.trim() || "10 meses",
                area,
                lotArea: parseInt(document.getElementById('projLotArea').value) || 360,
                beds,
                garage: parseInt(document.getElementById('projGarage').value) || 2,
                cost,
                valuation,
                photoUrl,
                floorplanUrl,
                description: document.getElementById('projDescription').value.trim()
            };

            if (existingId) {
                const idx = projects.findIndex(p => p.id === existingId);
                if (idx > -1) projects[idx] = projectData;
                showToast('Obra atualizada com sucesso!');
            } else {
                projects.unshift(projectData);
                showToast('Nova obra cadastrada e publicada na página inicial!');
            }

            persistDataToStorage();
            resetProjectForm();
            renderPublicProjects();
            renderAdminProjectsList();
        }

        function editProject(id) {
            const proj = projects.find(p => p.id === id);
            if (!proj) return;

            document.getElementById('projId').value = proj.id;
            document.getElementById('projTitle').value = proj.title;
            document.getElementById('projModality').value = proj.modality;
            document.getElementById('projStandard').value = proj.standard;
            document.getElementById('projLocation').value = proj.location;
            document.getElementById('projTimeline').value = proj.timeline;
            document.getElementById('projArea').value = proj.area;
            document.getElementById('projLotArea').value = proj.lotArea;
            document.getElementById('projBeds').value = proj.beds;
            document.getElementById('projGarage').value = proj.garage;
            document.getElementById('projCost').value = proj.cost;
            document.getElementById('projValuation').value = proj.valuation;
            document.getElementById('projPhotoUrl').value = proj.photoUrl;
            document.getElementById('projFloorplanUrl').value = proj.floorplanUrl;
            document.getElementById('projDescription').value = proj.description;

            document.getElementById('formProjectTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-brand-green"></i> Editando Obra`;
            document.getElementById('submitProjectBtnText').textContent = "Atualizar Obra";
            document.getElementById('cancelEditBtn').classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function deleteProject(id) {
            projects = projects.filter(p => p.id !== id);
            persistDataToStorage();
            renderPublicProjects();
            renderAdminProjectsList();
            showToast('Obra removida do portfólio.');
        }

        function resetProjectForm() {
            document.getElementById('projectForm').reset();
            document.getElementById('projId').value = '';
            document.getElementById('previewPhoto').classList.add('hidden');
            document.getElementById('previewFloorplan').classList.add('hidden');
            document.getElementById('formProjectTitle').innerHTML = `<i class="fa-solid fa-plus-circle text-brand-green"></i> 2. Cadastrar Obra Financiada`;
            document.getElementById('submitProjectBtnText').textContent = "Salvar e Publicar Obra no Site";
            document.getElementById('cancelEditBtn').classList.add('hidden');
        }

        function renderAdminProjectsList() {
            const container = document.getElementById('adminProjectsList');
            document.getElementById('adminProjectsCount').textContent = `${projects.length} obra(s)`;

            if (projects.length === 0) {
                container.innerHTML = `<div class="p-8 text-center text-slate-400 bg-brand-ice rounded-2xl">Nenhuma obra cadastrada. Use o formulário ao lado para adicionar.</div>`;
                return;
            }

            container.innerHTML = projects.map(proj => `
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-2xl bg-brand-ice border border-slate-200 hover:border-brand-blue transition">
                    <div class="flex items-center gap-4">
                        <img src="${proj.photoUrl}" alt="${proj.title}" onerror="this.src='https://placehold.co/200x200/0F3156/FFFFFF?text=Obra'" class="w-20 h-16 rounded-xl object-cover shrink-0 border border-slate-300">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-brand-blue text-white">${proj.modality}</span>
                                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-brand-green text-white">${proj.area} m²</span>
                            </div>
                            <h4 class="font-display font-bold text-base text-brand-blue mt-1">${proj.title}</h4>
                            <p class="text-xs text-slate-500">${proj.location} • Financiado: <strong>${formatBRL(proj.cost)}</strong></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 self-end sm:self-center">
                        <button onclick="editProject('${proj.id}')" class="px-3 py-2 rounded-xl bg-white hover:bg-brand-blue hover:text-white text-brand-blue border border-slate-200 text-xs font-bold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-pen"></i> Editar
                        </button>
                        <button onclick="deleteProject('${proj.id}')" class="px-3 py-2 rounded-xl bg-red-50 hover:bg-red-600 text-red-600 hover:text-white text-xs font-bold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-trash"></i> Excluir
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // ============================================================================
        // 7. INITIALIZE ON WINDOW LOAD
        // ============================================================================
        // ============================================================================
        // 7. HERO INTERACTIVE SLIDER, ADVANTAGES SLIDER & DIRECT INLINE EDITING
        // ============================================================================
        function formatNumberPoints(num) {
            return Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        function handleHeroDirectInput(rawVal) {
            const SFH_CEILING = 2250000;
            const numeric = parseInt(String(rawVal).replace(/\D/g, ''), 10) || 1020000;
            const clamped = Math.max(300000, Math.min(SFH_CEILING, numeric));
            if (numeric > SFH_CEILING) {
                showToast('Valor ajustado para R$ 2.250.000 (Teto máximo do SFH Caixa).');
            }
            const slider = document.getElementById('heroCostSlider');
            slider.max = SFH_CEILING;
            slider.value = clamped;
            updateHeroInteractiveCard();
        }

        function updateHeroInteractiveCard() {
            const sliderEl = document.getElementById('heroCostSlider');
            if (!sliderEl) return;
            const totalInvest = Math.min(2250000, parseFloat(sliderEl.value) || 1020000);
            const quotaPct = parseInt(document.getElementById('heroQuotaSlider').value, 10) || 80;
            const marginInput = document.getElementById('quickCfgMargin');
            const marketMarkupPct = marginInput ? (parseFloat(marginInput.value) || 30) : 30;

            // Update direct text input with formatted dots
            const directInput = document.getElementById('heroCostInputDirect');
            if (directInput && document.activeElement !== directInput) {
                directInput.value = formatNumberPoints(totalInvest);
            }

            // Calculate estimated area (m²) based on total investment (land + construction)
            const estimatedSqm = Math.max(85, Math.round((totalInvest * 0.72) / (simState.costPerSqm || 3350)));
            const sqmBadge = document.getElementById('heroCardSqmBadge');
            if (sqmBadge) sqmBadge.textContent = `(~${estimatedSqm} m²)`;

            // Caixa Financed vs Entry
            const financedVal = totalInvest * (quotaPct / 100);
            const entryVal = totalInvest - financedVal;
            const annualRate = (siteConfig.interestRate || 9.89) / 100;
            const monthlyRate = Math.pow(1 + annualRate, 1 / 12) - 1;
            const estFirstInst = (financedVal / 420) + (financedVal * monthlyRate) + 65;

            document.getElementById('heroQuotaLabel').textContent = `${quotaPct}%`;
            document.getElementById('heroCaixaFinancedValue').textContent = `Crédito Caixa: ${formatBRL(financedVal)}`;
            document.getElementById('heroEntryRequiredLabel').textContent = `Entrada/Lote (${100 - quotaPct}%): ${formatBRL(entryVal)}`;
            document.getElementById('heroEstimatedInstallment').textContent = `1ª Parc. ~${formatBRL(estFirstInst)}`;

            // Market Price vs Build With Us Price
            const readyMarketPrice = Math.round(totalInvest * (1 + (marketMarkupPct / 100)));
            const savings = readyMarketPrice - totalInvest;

            document.getElementById('heroReadyMarketPrice').textContent = formatBRL(readyMarketPrice);
            document.getElementById('heroBuildWithUsPrice').textContent = formatBRL(totalInvest);
            document.getElementById('heroEquitySavingsValue').textContent = `+ ${formatBRL(savings)}`;

            // Dynamic visual bar widths
            const ratioPercent = Math.max(45, Math.min(92, Math.round((totalInvest / readyMarketPrice) * 100)));
            const barBuild = document.getElementById('heroBarBuild');
            if (barBuild) barBuild.style.width = `${ratioPercent}%`;
        }

        function sendHeroQuickSimToWhatsApp() {
            const totalInvest = parseFloat(document.getElementById('heroCostSlider').value) || 1020000;
            const quotaPct = parseInt(document.getElementById('heroQuotaSlider').value, 10) || 80;
            const financedVal = totalInvest * (quotaPct / 100);
            const entryVal = totalInvest - financedVal;
            const savingsText = document.getElementById('heroEquitySavingsValue').textContent;
            const sqmText = document.getElementById('heroCardSqmBadge').textContent;

            const msg = `Olá! Usei o simulador rápido na capa do site *financiesuaobra.com.br*:\n\n` +
                `▪ *Investimento Desejado (Terreno + Obra):* ${formatBRL(totalInvest)} ${sqmText}\n` +
                `▪ *Crédito Financiado Caixa (${quotaPct}%):* ${formatBRL(financedVal)}\n` +
                `▪ *Entrada / Terreno (${100 - quotaPct}%):* ${formatBRL(entryVal)}\n` +
                `▪ *Economia / Ganho Patrimonial Estimado:* ${savingsText}\n\n` +
                `Gostaria de conversar com um especialista do Grupo Geminadas.com & Level!`;

            const cleanWa = (siteConfig.whatsapp || "5544999999999").replace(/\D/g, '');
            window.open(`https://wa.me/${cleanWa}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        function updateVantagensInteractive() {
            const slider = document.getElementById('vantagensSqmSlider');
            if (!slider) return;
            const sqm = parseInt(slider.value, 10) || 200;
            const buildCostPerSqm = 4650; // Includes proportional lot + construction cost
            const marketCostPerSqm = 6600; // Ready house market price per m²

            const buildTotal = sqm * buildCostPerSqm;
            const marketTotal = sqm * marketCostPerSqm;
            const diffSavings = marketTotal - buildTotal;

            document.getElementById('vantagensSqmLabel').textContent = `${sqm} m²`;
            document.getElementById('vantagensSqmEcho1').textContent = sqm;
            document.getElementById('vantagensSqmEcho2').textContent = sqm;
            document.getElementById('vantagensMarketVal').textContent = formatBRL(marketTotal);
            document.getElementById('vantagensBuildVal').textContent = formatBRL(buildTotal);
            document.getElementById('vantagensSavingsVal').textContent = `+ ${formatBRL(diffSavings)}`;
        }

        // Direct Inline Editing & Floating Draggable Bar Logic
        let isDirectEditMode = false;

        function toggleDirectEditMode() {
            isDirectEditMode = !isDirectEditMode;
            const body = document.body;
            const floatingBar = document.getElementById('floatingQuickAdminBar');
            const btnLabel = document.getElementById('directEditBtnLabel');
            const editableElements = document.querySelectorAll('[data-editable="true"]');

            if (isDirectEditMode) {
                body.classList.add('direct-edit-active');
                floatingBar.classList.remove('hidden');
                btnLabel.textContent = 'Sair da Edição Direta';
                editableElements.forEach(el => {
                    el.setAttribute('contenteditable', 'true');
                });
                // Populate quick admin fields
                document.getElementById('quickCfgWhatsapp').value = siteConfig.whatsapp || '';
                document.getElementById('quickCfgPhone').value = siteConfig.phoneDisplay || '';
                document.getElementById('quickCfgInstagram').value = siteConfig.instagram || '';
                document.getElementById('quickCfgFacebook').value = siteConfig.facebook || '';
                document.getElementById('quickCfgYoutube').value = siteConfig.youtube || '';
                showToast('Modo Edição Direta ativado! Clique nos textos ou arraste as barras.');
            } else {
                body.classList.remove('direct-edit-active');
                floatingBar.classList.add('hidden');
                btnLabel.textContent = 'Editar Direto no Site';
                editableElements.forEach(el => {
                    el.removeAttribute('contenteditable');
                });
                saveDirectEditsToStorage();
            }
        }

        function syncQuickAdminChanges() {
            siteConfig.whatsapp = document.getElementById('quickCfgWhatsapp').value.trim();
            siteConfig.phoneDisplay = document.getElementById('quickCfgPhone').value.trim();
            siteConfig.instagram = document.getElementById('quickCfgInstagram').value.trim();
            siteConfig.facebook = document.getElementById('quickCfgFacebook').value.trim();
            siteConfig.youtube = document.getElementById('quickCfgYoutube').value.trim();
            applySiteConfigToUI();
        }

        function moveFloatingWhatsappPosition(rightPx) {
            const btn = document.getElementById('floatingWhatsappBtn');
            if (btn) {
                btn.style.right = `${rightPx}px`;
            }
        }

        function saveDirectEditsToStorage() {
            const heroHeadlineEl = document.getElementById('heroHeadline');
            if (heroHeadlineEl) {
                siteConfig.heroTitle = heroHeadlineEl.innerHTML;
            }
            persistDataToStorage();
            showToast('Alterações feitas direto no site foram salvas!');
        }

        function initDraggableQuickBar() {
            const bar = document.getElementById('floatingQuickAdminBar');
            const handle = document.getElementById('quickAdminDragHeader');
            if (!bar || !handle) return;

            let isDragging = false;
            let startX = 0, startY = 0, initialLeft = 0, initialTop = 0;

            const startDrag = (clientX, clientY) => {
                isDragging = true;
                const rect = bar.getBoundingClientRect();
                initialLeft = rect.left;
                initialTop = rect.top;
                startX = clientX;
                startY = clientY;
            };

            const onMove = (clientX, clientY) => {
                if (!isDragging) return;
                const dx = clientX - startX;
                const dy = clientY - startY;
                const newLeft = Math.max(8, Math.min(window.innerWidth - bar.offsetWidth - 8, initialLeft + dx));
                const newTop = Math.max(8, Math.min(window.innerHeight - 80, initialTop + dy));
                bar.style.left = `${newLeft}px`;
                bar.style.top = `${newTop}px`;
            };

            handle.addEventListener('mousedown', (e) => startDrag(e.clientX, e.clientY));
            window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
            window.addEventListener('mouseup', () => { isDragging = false; });

            handle.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) startDrag(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
            window.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length === 1) onMove(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
            window.addEventListener('touchend', () => { isDragging = false; });
        }

        window.onload = function() {
            document.getElementById('currentYear').textContent = new Date().getFullYear();
            loadSavedDataFromStorage();
            applySiteConfigToUI();
            renderPublicProjects();
            renderAdminProjectsList();
            updateHeroInteractiveCard();
            updateVantagensInteractive();
            initDraggableQuickBar();
        };
    </script>
</body>
</html>